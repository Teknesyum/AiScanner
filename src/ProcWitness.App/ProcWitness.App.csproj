<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>ProcWitness</AssemblyName>
    <Product>ProcWitness</Product>
    <Company>Teknesyum</Company>
    <Authors>Teknesyum</Authors>
    <Description>Passive cross-platform process forensics and AI-ready evidence collection</Description>
    <Version>0.9.0</Version>
    <ApplicationIcon Condition="$([MSBuild]::IsOSPlatform('Windows'))">Assets\ProcWitness.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <ProjectReference Include="..\ProcWitness.Core\ProcWitness.Core.csproj" />
    <ProjectReference Include="..\ProcWitness.Infrastructure\ProcWitness.Infrastructure.csproj" />
    <AvaloniaResource Include="Assets\**" />
    <Content Include="Assets\ProcWitnessIcon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
