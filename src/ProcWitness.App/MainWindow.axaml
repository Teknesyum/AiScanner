<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ProcWitness.App.MainWindow"
        Title="ProcWitness" Width="1280" Height="860" MinWidth="1000" MinHeight="680" Background="#050509" Foreground="#E6FAFF" WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="Button"><Setter Property="Background" Value="#111522"/><Setter Property="Foreground" Value="#00F3FF"/><Setter Property="BorderBrush" Value="#00F3FF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,9"/><Setter Property="CornerRadius" Value="5"/></Style>
    <Style Selector="Button:pointerover"><Setter Property="Background" Value="#15303B"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="TextBox"><Setter Property="Background" Value="#0B0E16"/><Setter Property="Foreground" Value="#E6FAFF"/><Setter Property="BorderBrush" Value="#304050"/></Style>
    <Style Selector="TabItem"><Setter Property="Foreground" Value="#AAB6C8"/><Setter Property="Padding" Value="22,13"/></Style>
    <Style Selector="TabItem:selected"><Setter Property="Foreground" Value="#00F3FF"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="Margin" Value="0"/></Style>
    <Style Selector="Border.card"><Setter Property="Background" Value="#0B0E16"/><Setter Property="BorderBrush" Value="#304050"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
    <Style Selector="TextBlock.title"><Setter Property="Foreground" Value="#00F3FF"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="19"/></Style>
    <Style Selector="TextBlock.body"><Setter Property="Foreground" Value="#C5D0E0"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="16"/><Setter Property="LineHeight" Value="25"/><Setter Property="Margin" Value="0,8,0,0"/></Style>
    <Style Selector="TextBlock.step"><Setter Property="Foreground" Value="#E8F8FF"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="17"/><Setter Property="LineHeight" Value="27"/></Style>
  </Window.Styles>
  <Grid RowDefinitions="64,Auto,*,38">
    <Border Grid.Row="0" Background="#090C13" BorderBrush="#3300F3FF" BorderThickness="0,0,0,1" Padding="22,0">
      <Grid ColumnDefinitions="Auto,*,Auto"><Image Width="38" Height="38" Source="avares://ProcWitness/Assets/ProcWitnessIcon.png" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center"><TextBlock FontSize="22" FontWeight="Bold" Foreground="#00F3FF" Text="PROCWITNESS"/><TextBlock Foreground="#718097" Text="CROSS-PLATFORM PROCESS INTELLIGENCE"/></StackPanel><TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="#39FF14" Text="●  {Binding Status}"/></Grid>
    </Border>
    <Border Grid.Row="1" IsVisible="{Binding IsPromptNotificationVisible}" Background="#122D1B" BorderBrush="#39FF14" BorderThickness="1" CornerRadius="6" Margin="18,8,18,0" Padding="14,10"><TextBlock HorizontalAlignment="Center" FontSize="15" FontWeight="Bold" Foreground="#7CFF68" Text="✓ Analiz promptu panoya kopyalandı"/></Border>
    <TabControl Grid.Row="2" Margin="18,8">
      <TabItem Header="Tarama">
        <Grid RowDefinitions="Auto,*,Auto" Margin="0,12,0,0">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel VerticalAlignment="Center"><TextBlock Foreground="#8997AB" Text="{Binding SummaryText}" TextTrimming="CharacterEllipsis"/><TextBlock MaxWidth="460" FontSize="11" Foreground="#66758C" Text="{Binding PromptStatus}" TextTrimming="CharacterEllipsis"/></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="{Binding ScanButtonText}" Click="ScanNow_Click"/><Button x:Name="DurationMenuButton" Content="Süreli Analiz ▼"><Button.Flyout><Flyout Placement="BottomEdgeAlignedRight"><StackPanel Width="300" Spacing="10"><TextBlock FontSize="17" FontWeight="Bold" Foreground="#00F3FF" Text="Analiz süresini seçin"/><TextBlock FontSize="12" Foreground="#91A0BA" TextWrapping="Wrap" Text="Seçimden sonra pencere kapanır ve geri sayım Şimdi Tara düğmesinde görünür."/><UniformGrid Columns="2" Rows="2"><Button Tag="1" Margin="3" Content="1 dakika" Click="Duration_Click"/><Button Tag="5" Margin="3" Content="5 dakika" Click="Duration_Click"/><Button Tag="10" Margin="3" Content="10 dakika" Click="Duration_Click"/><Button Tag="20" Margin="3" Content="20 dakika" Click="Duration_Click"/></UniformGrid><Grid ColumnDefinitions="*,Auto"><TextBox x:Name="CustomMinutes" PlaceholderText="Özel dakika"/><Button Grid.Column="1" Margin="8,0,0,0" Content="Başlat" Click="CustomDuration_Click"/></Grid><Button Content="Veri klasörünü aç" Click="OpenDataFolder_Click"/></StackPanel></Flyout></Button.Flyout></Button><Button Content="{Binding PromptButtonText}" Background="{Binding PromptButtonBackground}" Foreground="{Binding PromptButtonForeground}" BorderBrush="{Binding PromptButtonBorder}" IsVisible="{Binding HasCompletedAnalysis}" Click="CreatePrompt_Click"/><Button Content="Prompt Konumu" IsVisible="{Binding HasPromptFile}" Click="OpenPromptLocation_Click"/><Button Content="Analizi Aç" IsVisible="{Binding IsTimedReportVisible}" Click="OpenAnalysis_Click"/></StackPanel>
          </Grid>
          <Grid Grid.Row="1" RowDefinitions="32,*" Margin="0,14">
            <Border Background="#111522" BorderBrush="#304050" BorderThickness="0,0,0,1" Padding="8,0"><Grid ColumnDefinitions="55,155,65,85,75,75,55,60,75,140,*"><TextBlock FontSize="11" VerticalAlignment="Center" Text="PID"/><TextBlock Grid.Column="1" FontSize="11" VerticalAlignment="Center" Text="SÜREÇ"/><TextBlock Grid.Column="2" FontSize="11" VerticalAlignment="Center" Text="CPU"/><TextBlock Grid.Column="3" FontSize="11" VerticalAlignment="Center" Text="RAM"/><TextBlock Grid.Column="4" FontSize="11" VerticalAlignment="Center" Text="UPLOAD"/><TextBlock Grid.Column="5" FontSize="11" VerticalAlignment="Center" Text="DOWNLOAD"/><TextBlock Grid.Column="6" FontSize="11" VerticalAlignment="Center" Text="AĞ"/><TextBlock Grid.Column="7" FontSize="11" VerticalAlignment="Center" Text="SKOR"/><TextBlock Grid.Column="8" FontSize="11" VerticalAlignment="Center" Text="RİSK"/><TextBlock Grid.Column="9" FontSize="11" VerticalAlignment="Center" Text="YAYINCI"/><TextBlock Grid.Column="10" FontSize="11" VerticalAlignment="Center" Text="BULGULAR"/></Grid></Border>
            <ListBox Grid.Row="1" ItemsSource="{Binding Assessments}" SelectedItem="{Binding SelectedAssessment}" FontSize="10" DoubleTapped="ProcessList_DoubleTapped"><ListBox.ItemTemplate><DataTemplate><Border Height="18" BorderBrush="#18202C" BorderThickness="0,0,0,1" Padding="8,0"><Grid ColumnDefinitions="55,155,65,85,75,75,55,60,75,140,*"><TextBlock Text="{Binding Process.ProcessId}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Process.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding Process.CpuPercent, StringFormat={}{0:F1}%}" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{Binding Process.WorkingSetBytes, StringFormat={}{0:N0} B}" VerticalAlignment="Center"/><TextBlock Grid.Column="4" Text="{Binding Process.SentMegabytes, StringFormat={}{0:F2} MB}" VerticalAlignment="Center"/><TextBlock Grid.Column="5" Text="{Binding Process.ReceivedMegabytes, StringFormat={}{0:F2} MB}" VerticalAlignment="Center"/><TextBlock Grid.Column="6" Text="{Binding Process.ActiveConnections}" VerticalAlignment="Center"/><TextBlock Grid.Column="7" Text="{Binding Score}" FontWeight="Bold" Foreground="{Binding RiskColor}" VerticalAlignment="Center"/><TextBlock Grid.Column="8" Text="{Binding Level}" FontWeight="Bold" Foreground="{Binding RiskColor}" VerticalAlignment="Center"/><TextBlock Grid.Column="9" Text="{Binding Process.Publisher}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="10" Text="{Binding FindingsSummary}" Foreground="{Binding RiskColor}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
          </Grid>
          <Border Grid.Row="2" Classes="card" IsVisible="{Binding IsTimedReportVisible}" BorderBrush="#5539FF14"><StackPanel><TextBlock Classes="title" Foreground="#7CFF68" Text="SÜRELİ ANALİZ RAPORU"/><TextBox Margin="0,10,0,0" MaxHeight="230" Text="{Binding LocalAnalysisReport}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"/></StackPanel></Border>
        </Grid>
      </TabItem>
      <TabItem Header="Kalıcılık">
        <Grid RowDefinitions="Auto,*" Margin="0,12,0,0">
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12"><TextBlock VerticalAlignment="Center" Foreground="#91A0BA" Text="{Binding PersistenceStatus}"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="Yenile" Click="RefreshPersistence_Click"/><Button Content="Dosya konumunu aç" Click="OpenPersistenceLocation_Click"/></StackPanel></Grid>
          <Grid Grid.Row="1" RowDefinitions="32,*">
            <Border Background="#111522" BorderBrush="#304050" BorderThickness="0,0,0,1" Padding="8,0"><Grid ColumnDefinitions="150,190,80,140,*,110"><TextBlock FontSize="11" VerticalAlignment="Center" Text="KAYNAK"/><TextBlock Grid.Column="1" FontSize="11" VerticalAlignment="Center" Text="AD"/><TextBlock Grid.Column="2" FontSize="11" VerticalAlignment="Center" Text="ETKİN"/><TextBlock Grid.Column="3" FontSize="11" VerticalAlignment="Center" Text="İMZA"/><TextBlock Grid.Column="4" FontSize="11" VerticalAlignment="Center" Text="KOMUT"/><TextBlock Grid.Column="5" FontSize="11" VerticalAlignment="Center" Text="BAĞLI PID"/></Grid></Border>
            <ListBox Grid.Row="1" ItemsSource="{Binding PersistenceEntries}" SelectedItem="{Binding SelectedPersistence}" FontSize="10"><ListBox.ItemTemplate><DataTemplate><Border Height="22" BorderBrush="#18202C" BorderThickness="0,0,0,1" Padding="8,0"><Grid ColumnDefinitions="150,190,80,140,*,110"><TextBlock Text="{Binding Source}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding Enabled}" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{Binding SignatureStatus}" VerticalAlignment="Center"/><TextBlock Grid.Column="4" Text="{Binding Command}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="5" Text="{Binding LinkedProcessIds.Count}" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="Nasıl Kullanılır?">
        <ScrollViewer><Viewbox Stretch="Uniform" StretchDirection="UpOnly" HorizontalAlignment="Center" MaxWidth="1250"><StackPanel Width="1000" Margin="24">
          <TextBlock HorizontalAlignment="Center" FontSize="30" FontWeight="Bold" Foreground="#39FF14" Text="5 ADIMDA PROCWITNESS"/>
          <TextBlock Margin="0,8,0,24" HorizontalAlignment="Center" Foreground="#AAB8CA" FontSize="16" Text="Tarama ve AI raporu için kısa kullanım rehberi"/>
          <Border Classes="card" BorderBrush="#00F3FF"><TextBlock Classes="step"><Run Foreground="#00F3FF" FontWeight="Bold" Text="1 • ŞİMDİ TARA  "/><Run Text="Tarama sekmesindeki düğmeye basın. Çalışan süreçler yerel olarak incelenir. Bir süreci seçerek yolunu, SHA-256 değerini ve yayıncısını görün."/></TextBlock></Border>
          <Border Classes="card" BorderBrush="#C779FF"><TextBlock Classes="step"><Run Foreground="#C779FF" FontWeight="Bold" Text="2 • SÜRELİ DİNLE  "/><Run Text="Süreli Analiz sekmesinden 1, 5, 10, 20 veya özel dakika seçin. Program süre dolana kadar veri toplar. Miner ve aralıklı casus yazılım davranışları için 10–20 dakika önerilir."/></TextBlock></Border>
          <Border Classes="card" BorderBrush="#FFB000"><TextBlock Classes="step"><Run Foreground="#FFCA55" FontWeight="Bold" Text="3 • YEREL RAPORU OKU  "/><Run Text="Süre bitince önemsiz ve kararlı süreçler elenir. Yüksek puan kesin zararlı demek değildir; önce incelenmesi gereken adayı gösterir."/></TextBlock></Border>
          <Border Classes="card" BorderBrush="#39FF14"><TextBlock Classes="step"><Run Foreground="#7CFF68" FontWeight="Bold" Text="4 • PROMPTU KOPYALA  "/><Run Text="Analiz için prompt oluştur düğmesine basın. Düğme yeşile döner ve kopyalandığını bildirir. Promptu Codex veya başka bir AI’a yapıştırın."/></TextBlock></Border>
          <Border Classes="card" BorderBrush="#FF647C"><TextBlock Classes="step"><Run Foreground="#FF8295" FontWeight="Bold" Text="5 • GÜVENLİ DOĞRULA  "/><Run Text="AI dosya isterse promptta yolu yazan analysis-*.json dosyasını yükleyin. Yol, yayıncı ve SHA-256 değerini doğrulamadan dosya silmeyin veya süreç sonlandırmayın."/></TextBlock></Border>
        </StackPanel></Viewbox></ScrollViewer>
      </TabItem>
      <TabItem Header="Bilgi">
        <ScrollViewer><StackPanel MaxWidth="1500" HorizontalAlignment="Stretch" Margin="28"><Image Width="82" Height="82" Source="avares://ProcWitness/Assets/ProcWitnessIcon.png"/><TextBlock HorizontalAlignment="Center" Margin="0,12,0,6" FontSize="30" FontWeight="Bold" Foreground="#00F3FF" Text="PROCWITNESS TEKNİK REHBERİ"/><TextBlock MaxWidth="1300" HorizontalAlignment="Center" TextAlignment="Center" Classes="body" Margin="0,0,0,24" Text="CPU, RAM, dosya kimliği, imza, bağlantı ve zaman içindeki davranışı birlikte inceleyen yerel telemetri ve önceliklendirme sistemi."/>
          <Border Classes="card"><StackPanel><TextBlock Classes="title" Text="01 • VERİ TOPLAMA"/><TextBlock Classes="body" Text="• PID, süreç adı ve başlangıç zamanı&#10;• CPU ve fiziksel RAM kullanımı&#10;• Dosya yolu, oluşturulma zamanı ve SHA-256&#10;• Windows Authenticode / macOS codesign&#10;• Ölçülemeyen özellikler risk sayılmaz"/></StackPanel></Border>
          <Border Classes="card"><StackPanel><TextBlock Classes="title" Text="02 • AĞ GÖZLEMİ"/><TextBlock Classes="body" Text="• Windows: ETW upload/download + IP Helper&#10;• Linux: /proc soket–PID eşleştirmesi&#10;• macOS: lsof ile etkin TCP uçları&#10;• Uzak IP ve portlar süreçle ilişkilendirilir&#10;• Ölçüm yoksa 0 B güvenli kabul edilmez"/></StackPanel></Border>
          <Border Classes="card"><StackPanel><TextBlock Classes="title" Text="03 • SÜRELİ DİNLEME"/><TextBlock Classes="body" Text="• 1, 5, 10, 20 veya özel dakika&#10;• Yaklaşık 4 saniyede bir yeni örnek&#10;• Canlı geri sayım&#10;• Eski veriler oturuma karıştırılmaz&#10;• Yalnızca gerçek başlangıç–bitiş aralığı raporlanır"/></StackPanel></Border>
          <Border Classes="card"><StackPanel><TextBlock Classes="title" Text="04 • DAVRANIŞ MOTORU"/><TextBlock Classes="body" Text="• Sürekli veya aniden yükselen CPU&#10;• Penceresiz yoğun çalışma&#10;• Yeni / yazılabilir dizindeki dosyalar&#10;• İmza + ağ bağlantısı birleşimi&#10;• Yeniden doğan PID ve sıra dışı trafik"/></StackPanel></Border>
          <Border Classes="card"><StackPanel><TextBlock Classes="title" Text="05 • AKILLI FİLTRE"/><TextBlock Classes="body" Text="• Sabit ve düşük yük üreten süreçleri eler&#10;• CPU sıçraması olanları korur&#10;• Ağ / yeni dosya / imza sinyalini korur&#10;• PID değişimini gözden kaçırmaz&#10;• AI’a yalnızca anlamlı adayları verir"/></StackPanel></Border>
          <Border Classes="card"><StackPanel><TextBlock Classes="title" Text="06 • RAPOR ÇIKTILARI"/><TextBlock Classes="body" Text="• Kronolojik telemetry.jsonl&#10;• Korelasyonlu analysis-*.json&#10;• Yerel okunabilir özet&#10;• Panoya hazır AI promptu&#10;• Dosya yolu + SHA-256 ile inceleme adayı"/></StackPanel></Border>
          <Border Classes="card"><StackPanel><TextBlock Classes="title" Text="07 • CANLI RİSK PUANLAMA"/><TextBlock Classes="body" Text="• 0–14 Temiz  • 15–29 Düşük&#10;• 30–54 Orta  • 55–79 Yüksek&#10;• 80–100 Kritik&#10;• CPU ≥ %35 ve ≥ %70 ayrı eşiklerdir&#10;• Tek sinyal değil, birleşik bulgular puanlanır"/></StackPanel></Border>
          <Border Classes="card"><StackPanel><TextBlock Classes="title" Text="08 • ZAMAN SERİSİ VE KORELASYON"/><TextBlock Classes="body" Text="• Örnekler ad + yol + SHA-256 ile birleşir&#10;• Ortalama / tepe / CPU aralığı hesaplanır&#10;• Tepe RAM ve ilk–son görülme tutulur&#10;• Farklı PID sayısı ve yeniden doğuş izlenir&#10;• Örnek: %5 → uzun süre %90 davranışı yakalanır"/></StackPanel></Border>
          <Border Classes="card"><StackPanel><TextBlock Classes="title" Text="09 • MINER / KAÇINMA TESPİTİ"/><TextBlock Classes="body" Text="• Sürekli yüksek CPU + penceresiz çalışma&#10;• Yazılabilir dizin + doğrulanamayan yayıncı&#10;• Görev Yöneticisi öncesi 20 sn incelenir&#10;• Açıldıktan sonraki 15 sn ile karşılaştırılır&#10;• ≥ %30 yükün %5’e / beşte birine düşmesi işaretlenir"/></StackPanel></Border>
          <Border Classes="card"><StackPanel><TextBlock Classes="title" Text="10 • AĞ VE VERİ AKIŞI"/><TextBlock Classes="body" Text="• Sayaç farkları PID bazında hesaplanır&#10;• Upload ≥ 256 KB: anlamlı değişim&#10;• Upload ≥ 10 MB: yüksek sinyal&#10;• Download ≥ 25 MB: dikkat sinyali&#10;• Uzak IP/port ve süreç türü birlikte yorumlanır"/></StackPanel></Border>
          <Border Classes="card"><StackPanel><TextBlock Classes="title" Text="11 • AI VERİ PAKETİ"/><TextBlock Classes="body" Text="• Tepe CPU &lt; %15 ve değişim &lt; 12 ise gürültü elenir&#10;• Ağ / yeni dosya / imza / PID sinyali korunur&#10;• Adaylar yerel risk skoruyla sıralanır&#10;• Yalnızca anlamlı zaman noktaları eklenir&#10;• AI’dan kanıt, belirsizlik ve yanlış pozitif istenir"/></StackPanel></Border>
          <Border Classes="card"><StackPanel><TextBlock Classes="title" Text="12 • MAHREMİYET VE SINIRLAR"/><TextBlock Classes="body" Text="• Tüm kayıtlar ProcWitness/data içinde yereldir&#10;• Veriler otomatik olarak internete gönderilmez&#10;• 256 MB sonrası son 7 gün korunarak sıkıştırılır&#10;• Dosya silmez, karantinaya almaz, süreç kapatmaz&#10;• Son karar: hash + yayıncı + antivirüs/EDR"/></StackPanel></Border>
        </StackPanel></ScrollViewer>
      </TabItem>
    </TabControl>
    <Border Grid.Row="3" Background="#090C13" BorderBrush="#3300F3FF" BorderThickness="0,1,0,0" Padding="18,0"><Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto"><Button Grid.Column="0" Padding="10,3" Margin="0,3,10,3" FontSize="11" Content="EN" Click="ToggleLanguage_Click"/><TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="#738198" Text="{Binding VersionText}"/><Button Grid.Column="3" Padding="10,3" Margin="0,3,8,3" FontSize="11" Content="Buy Me a Coffee" Click="OpenSponsor_Click"/><Button Grid.Column="4" Padding="10,3" Margin="0,3" FontSize="11" Foreground="#39FF14" BorderBrush="#39FF14" Content="Teknesyum" Click="OpenGitHub_Click"/></Grid></Border>
  </Grid>
</Window>
