<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ProcWitness.App.MainWindow"
        Title="ProcWitness" Width="1280" Height="860" MinWidth="1000" MinHeight="680" Background="#050509" Foreground="#E6FAFF" WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="Button"><Setter Property="Background" Value="#111522"/><Setter Property="Foreground" Value="#00F3FF"/><Setter Property="BorderBrush" Value="#00F3FF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,9"/><Setter Property="CornerRadius" Value="5"/></Style>
    <Style Selector="Button:pointerover"><Setter Property="Background" Value="#15303B"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="TextBox"><Setter Property="Background" Value="#0B0E16"/><Setter Property="Foreground" Value="#E6FAFF"/><Setter Property="BorderBrush" Value="#304050"/></Style>
    <Style Selector="TabItem"><Setter Property="Foreground" Value="#AAB6C8"/><Setter Property="Padding" Value="22,13"/></Style>
    <Style Selector="TabItem:selected"><Setter Property="Foreground" Value="#00F3FF"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="Margin" Value="0"/></Style>
    <Style Selector="Border.card"><Setter Property="Background" Value="#0B0E16"/><Setter Property="BorderBrush" Value="#304050"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
    <Style Selector="TextBlock.title"><Setter Property="Foreground" Value="#00F3FF"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="19"/></Style>
    <Style Selector="TextBlock.body"><Setter Property="Foreground" Value="#C5D0E0"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="16"/><Setter Property="LineHeight" Value="25"/><Setter Property="Margin" Value="0,8,0,0"/></Style>
    <Style Selector="TextBlock.step"><Setter Property="Foreground" Value="#E8F8FF"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="17"/><Setter Property="LineHeight" Value="27"/></Style>
  </Window.Styles>
  <Grid RowDefinitions="64,Auto,*,38">
    <Border Grid.Row="0" Background="#090C13" BorderBrush="#3300F3FF" BorderThickness="0,0,0,1" Padding="22,0">
      <Grid ColumnDefinitions="Auto,*,Auto"><Image Width="38" Height="38" Source="avares://ProcWitness/Assets/ProcWitnessIcon.png" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center"><TextBlock FontSize="22" FontWeight="Bold" Foreground="#00F3FF" Text="PROCWITNESS"/><TextBlock Foreground="#718097" Text="CROSS-PLATFORM PROCESS INTELLIGENCE"/></StackPanel><TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="#39FF14" Text="●  {Binding Status}"/></Grid>
    </Border>
    <Border Grid.Row="1" IsVisible="{Binding IsPromptNotificationVisible}" Background="#122D1B" BorderBrush="#39FF14" BorderThickness="1" CornerRadius="6" Margin="18,8,18,0" Padding="14,10"><TextBlock HorizontalAlignment="Center" FontSize="15" FontWeight="Bold" Foreground="#7CFF68" Text="✓ Analysis prompt copied to clipboard"/></Border>
    <TabControl Grid.Row="2" Margin="18,8">
      <TabItem Header="Scan">
        <Grid RowDefinitions="Auto,*,Auto" Margin="0,12,0,0">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel VerticalAlignment="Center"><TextBlock Foreground="#8997AB" Text="{Binding SummaryText}" TextTrimming="CharacterEllipsis"/><TextBlock MaxWidth="460" FontSize="11" Foreground="#66758C" Text="{Binding PromptStatus}" TextTrimming="CharacterEllipsis"/></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="{Binding ScanButtonText}" Click="ScanNow_Click"/><Button x:Name="DurationMenuButton" Content="Timed Analysis ▼"><Button.Flyout><Flyout Placement="BottomEdgeAlignedRight"><StackPanel Width="300" Spacing="10"><TextBlock FontSize="17" FontWeight="Bold" Foreground="#00F3FF" Text="Choose analysis duration"/><TextBlock FontSize="12" Foreground="#91A0BA" TextWrapping="Wrap" Text="The menu closes after selection and the countdown appears on Scan Now."/><UniformGrid Columns="2" Rows="2"><Button Tag="1" Margin="3" Content="1 minute" Click="Duration_Click"/><Button Tag="5" Margin="3" Content="5 minutes" Click="Duration_Click"/><Button Tag="10" Margin="3" Content="10 minutes" Click="Duration_Click"/><Button Tag="20" Margin="3" Content="20 minutes" Click="Duration_Click"/></UniformGrid><Grid ColumnDefinitions="*,Auto"><TextBox x:Name="CustomMinutes" PlaceholderText="Custom minutes"/><Button Grid.Column="1" Margin="8,0,0,0" Content="Start" Click="CustomDuration_Click"/></Grid><Button Content="Open Data Folder" Click="OpenDataFolder_Click"/></StackPanel></Flyout></Button.Flyout></Button><Button Content="{Binding PromptButtonText}" Background="{Binding PromptButtonBackground}" Foreground="{Binding PromptButtonForeground}" BorderBrush="{Binding PromptButtonBorder}" IsVisible="{Binding HasCompletedAnalysis}" Click="CreatePrompt_Click"/><Button Content="Prompt Location" IsVisible="{Binding HasPromptFile}" Click="OpenPromptLocation_Click"/><Button Content="Open Analysis" IsVisible="{Binding IsTimedReportVisible}" Click="OpenAnalysis_Click"/></StackPanel>
          </Grid>
          <Grid Grid.Row="1" RowDefinitions="32,*" Margin="0,14">
            <Border Background="#111522" BorderBrush="#304050" BorderThickness="0,0,0,1" Padding="8,0"><Grid ColumnDefinitions="55,155,65,85,75,75,55,60,75,140,*"><TextBlock FontSize="11" VerticalAlignment="Center" Text="PID"/><TextBlock Grid.Column="1" FontSize="11" VerticalAlignment="Center" Text="PROCESS"/><TextBlock Grid.Column="2" FontSize="11" VerticalAlignment="Center" Text="CPU"/><TextBlock Grid.Column="3" FontSize="11" VerticalAlignment="Center" Text="RAM"/><TextBlock Grid.Column="4" FontSize="11" VerticalAlignment="Center" Text="UPLOAD"/><TextBlock Grid.Column="5" FontSize="11" VerticalAlignment="Center" Text="DOWNLOAD"/><TextBlock Grid.Column="6" FontSize="11" VerticalAlignment="Center" Text="NET"/><TextBlock Grid.Column="7" FontSize="11" VerticalAlignment="Center" Text="SCORE"/><TextBlock Grid.Column="8" FontSize="11" VerticalAlignment="Center" Text="RISK"/><TextBlock Grid.Column="9" FontSize="11" VerticalAlignment="Center" Text="PUBLISHER"/><TextBlock Grid.Column="10" FontSize="11" VerticalAlignment="Center" Text="FINDINGS"/></Grid></Border>
            <ListBox Grid.Row="1" ItemsSource="{Binding Assessments}" SelectedItem="{Binding SelectedAssessment}" FontSize="10" DoubleTapped="ProcessList_DoubleTapped"><ListBox.ItemTemplate><DataTemplate><Border Height="18" BorderBrush="#18202C" BorderThickness="0,0,0,1" Padding="8,0"><Grid ColumnDefinitions="55,155,65,85,75,75,55,60,75,140,*"><TextBlock Text="{Binding Process.ProcessId}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Process.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding Process.CpuPercent, StringFormat={}{0:F1}%}" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{Binding Process.WorkingSetBytes, StringFormat={}{0:N0} B}" VerticalAlignment="Center"/><TextBlock Grid.Column="4" Text="{Binding Process.SentMegabytes, StringFormat={}{0:F2} MB}" VerticalAlignment="Center"/><TextBlock Grid.Column="5" Text="{Binding Process.ReceivedMegabytes, StringFormat={}{0:F2} MB}" VerticalAlignment="Center"/><TextBlock Grid.Column="6" Text="{Binding Process.ActiveConnections}" VerticalAlignment="Center"/><TextBlock Grid.Column="7" Text="{Binding Score}" FontWeight="Bold" Foreground="{Binding RiskColor}" VerticalAlignment="Center"/><TextBlock Grid.Column="8" Text="{Binding Level}" FontWeight="Bold" Foreground="{Binding RiskColor}" VerticalAlignment="Center"/><TextBlock Grid.Column="9" Text="{Binding Process.Publisher}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="10" Text="{Binding FindingsSummary}" Foreground="{Binding RiskColor}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
          </Grid>
          <Border Grid.Row="2" Classes="card" IsVisible="{Binding IsTimedReportVisible}" BorderBrush="#5539FF14"><StackPanel><TextBlock Classes="title" Foreground="#7CFF68" Text="TIMED ANALYSIS REPORT"/><TextBox Margin="0,10,0,0" MaxHeight="230" Text="{Binding LocalAnalysisReport}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"/></StackPanel></Border>
        </Grid>
      </TabItem>
      <TabItem Header="Persistence">
        <Grid RowDefinitions="Auto,*" Margin="0,12,0,0">
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12"><TextBlock VerticalAlignment="Center" Foreground="#91A0BA" Text="{Binding PersistenceStatus}"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="Refresh" Click="RefreshPersistence_Click"/><Button Content="Open file location" Click="OpenPersistenceLocation_Click"/></StackPanel></Grid>
          <Grid Grid.Row="1" RowDefinitions="32,*">
            <Border Background="#111522" BorderBrush="#304050" BorderThickness="0,0,0,1" Padding="8,0"><Grid ColumnDefinitions="150,190,80,140,*,110"><TextBlock FontSize="11" VerticalAlignment="Center" Text="SOURCE"/><TextBlock Grid.Column="1" FontSize="11" VerticalAlignment="Center" Text="NAME"/><TextBlock Grid.Column="2" FontSize="11" VerticalAlignment="Center" Text="ENABLED"/><TextBlock Grid.Column="3" FontSize="11" VerticalAlignment="Center" Text="SIGNATURE"/><TextBlock Grid.Column="4" FontSize="11" VerticalAlignment="Center" Text="COMMAND"/><TextBlock Grid.Column="5" FontSize="11" VerticalAlignment="Center" Text="LINKED PID"/></Grid></Border>
            <ListBox Grid.Row="1" ItemsSource="{Binding PersistenceEntries}" SelectedItem="{Binding SelectedPersistence}" FontSize="10"><ListBox.ItemTemplate><DataTemplate><Border Height="22" BorderBrush="#18202C" BorderThickness="0,0,0,1" Padding="8,0"><Grid ColumnDefinitions="150,190,80,140,*,110"><TextBlock Text="{Binding Source}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding Enabled}" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{Binding SignatureStatus}" VerticalAlignment="Center"/><TextBlock Grid.Column="4" Text="{Binding Command}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="5" Text="{Binding LinkedProcessIds.Count}" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="Baseline">
        <Grid RowDefinitions="Auto,Auto,*" Margin="0,12,0,0">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><ComboBox ItemsSource="{Binding BaselineFiles}" SelectedItem="{Binding SelectedBaseline}" PlaceholderText="Select baseline"/><Button Grid.Column="1" Content="Save baseline" Click="SaveBaseline_Click"/><Button Grid.Column="2" Content="Compare" Click="CompareBaseline_Click"/></Grid>
          <TextBlock Grid.Row="1" Margin="0,12" Foreground="#91A0BA" Text="{Binding BaselineStatus}"/>
          <ListBox Grid.Row="2" ItemsSource="{Binding BaselineDifferences}" FontSize="11"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#18202C" BorderThickness="0,0,0,1" Padding="10,6"><Grid ColumnDefinitions="120,180,*,220"><TextBlock Text="{Binding Category}" Foreground="{Binding HighlightColor}"/><TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="{Binding Path}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="3" Text="{Binding CurrentSha256}" TextTrimming="CharacterEllipsis"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
        </Grid>
      </TabItem>
      <TabItem Header="Ayarlar">
        <ScrollViewer><StackPanel MaxWidth="1050" Margin="24" Spacing="14">
          <TextBlock Classes="title" Text="GENERAL"/>
          <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10"><TextBlock VerticalAlignment="Center" Text="Language"/><ComboBox Grid.Column="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding SettingsLanguage}" SelectionChanged="SettingsLanguageChanged"/><TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Sample interval"/><ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding SampleIntervals}" SelectedItem="{Binding SampleIntervalSeconds}"/><TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Retention days"/><ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding RetentionOptions}" SelectedItem="{Binding RetentionDays}"/><TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Local data directory"/><Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,Auto"><TextBox IsReadOnly="True" Text="{Binding DataDirectoryText}"/><Button Grid.Column="1" Margin="8,0,0,0" Content="Open" Click="OpenDataFolder_Click"/></Grid><CheckBox Grid.Row="4" Grid.ColumnSpan="2" Content="Automatic scan on startup" IsChecked="{Binding AutoScanOnStartup}"/></Grid>
          <TextBlock Classes="title" Margin="0,12,0,0" Text="ANALYSIS"/>
          <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10"><TextBlock VerticalAlignment="Center" Text="Default capture minutes"/><TextBox Grid.Column="1" Text="{Binding DefaultCaptureMinutes}"/><CheckBox Grid.Row="1" Grid.ColumnSpan="2" Content="Enable read-only persistence inventory" IsChecked="{Binding PersistenceEnabled}"/><CheckBox Grid.Row="2" Grid.ColumnSpan="2" Content="Enable verified publisher allowlist" IsChecked="{Binding PublisherAllowlistEnabled}"/><CheckBox Grid.Row="3" Grid.ColumnSpan="2" Content="Include raw snapshots in bundles and AI payloads" IsChecked="{Binding IncludeRawSnapshots}"/></Grid>
          <TextBlock Classes="title" Margin="0,12,0,0" Text="AI PROVIDER • OPTIONAL / DEFAULT OFF"/>
          <CheckBox Content="Enable direct AI reports" IsChecked="{Binding AiEnabled}"/>
          <TextBlock Foreground="#FFCA55" TextWrapping="Wrap" Text="Your key is stored only on this machine. When you request an AI report, the prepared evidence payload is sent to the selected provider. This is the only exception to ProcWitness's default local-only behavior."/>
          <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10"><TextBlock VerticalAlignment="Center" Text="Provider"/><ComboBox Grid.Column="1" ItemsSource="{Binding AiProviders}" SelectedItem="{Binding SelectedAiProvider}" SelectionChanged="ProviderChanged"/><TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Model"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AiModel}"/><TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Endpoint"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding AiEndpoint}"/><TextBlock Grid.Row="3" VerticalAlignment="Center" Text="API key"/><Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,Auto,Auto"><TextBox x:Name="ApiKeyBox" PasswordChar="•" Text="{Binding ApiKey}"/><Button Grid.Column="1" Margin="8,0" Content="Show" Click="ToggleApiKey_Click"/><Button Grid.Column="2" Content="Paste" Click="PasteApiKey_Click"/></Grid></Grid>
          <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Save settings" Click="SaveSettings_Click"/><Button Content="Test connection" Click="TestAiConnection_Click"/><Button Content="Get AI report" IsEnabled="{Binding CanRequestAiReport}" Click="RequestAiReport_Click"/><Button Content="Delete all local data" Foreground="#FF8295" BorderBrush="#FF385C" Click="DeleteLocalData_Click"/></StackPanel>
          <TextBlock Foreground="#91A0BA" TextWrapping="Wrap" Text="{Binding SettingsStatus}"/>
          <TextBlock Classes="title" Margin="0,12,0,0" Text="ABOUT"/><TextBlock TextWrapping="Wrap" Text="ProcWitness • MIT License • Teknesyum&#10;GitHub and sponsor links are available in the footer."/>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="AI Raporu">
        <Grid RowDefinitions="Auto,*" Margin="0,12,0,0"><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Copy report" Click="CopyAiReport_Click"/><Button Content="Open report file" Click="OpenAiReport_Click"/><Button Content="Cancel request" Click="CancelAiReport_Click"/></StackPanel><ScrollViewer Grid.Row="1" Margin="0,12,0,0"><StackPanel x:Name="MarkdownReportPanel" MaxWidth="1100" HorizontalAlignment="Stretch"/></ScrollViewer></Grid>
      </TabItem>
      <TabItem Header="How to Use">
        <ScrollViewer><Viewbox Stretch="Uniform" StretchDirection="UpOnly" HorizontalAlignment="Center" MaxWidth="1250"><StackPanel Width="1000" Margin="24">
          <TextBlock HorizontalAlignment="Center" FontSize="30" FontWeight="Bold" Foreground="#39FF14" Text="PROCWITNESS IN 5 STEPS"/>
          <TextBlock Margin="0,8,0,24" HorizontalAlignment="Center" Foreground="#AAB8CA" FontSize="16" Text="Quick guide to scanning and AI reports"/>
          <Border Classes="card" BorderBrush="#00F3FF"><TextBlock Classes="step"><Run Foreground="#00F3FF" FontWeight="Bold" Text="1 • SCAN NOW  "/><Run Text="Press Scan Now. Processes are analyzed locally. Select one to inspect its path, SHA-256 and publisher."/></TextBlock></Border>
          <Border Classes="card" BorderBrush="#C779FF"><TextBlock Classes="step"><Run Foreground="#C779FF" FontWeight="Bold" Text="2 • TIMED MONITORING  "/><Run Text="Choose 1, 5, 10, 20 or custom minutes. The app records the full interval; 10–20 minutes helps reveal miners and intermittent spyware."/></TextBlock></Border>
          <Border Classes="card" BorderBrush="#FFB000"><TextBlock Classes="step"><Run Foreground="#FFCA55" FontWeight="Bold" Text="3 • READ THE LOCAL REPORT  "/><Run Text="Stable low-value processes are filtered when the timer ends. A high score is an investigation priority, not proof of malware."/></TextBlock></Border>
          <Border Classes="card" BorderBrush="#39FF14"><TextBlock Classes="step"><Run Foreground="#7CFF68" FontWeight="Bold" Text="4 • COPY THE PROMPT  "/><Run Text="Click Copy Prompt. The button turns green and confirms the copy. Paste it into Codex or another AI."/></TextBlock></Border>
          <Border Classes="card" BorderBrush="#FF647C"><TextBlock Classes="step"><Run Foreground="#FF8295" FontWeight="Bold" Text="5 • VERIFY SAFELY  "/><Run Text="If the AI requests evidence, attach the referenced analysis-*.json file. Verify path, publisher and SHA-256 before deleting files or stopping processes."/></TextBlock></Border>
        </StackPanel></Viewbox></ScrollViewer>
      </TabItem>
      <TabItem Header="Information">
        <ScrollViewer><StackPanel MaxWidth="1500" HorizontalAlignment="Stretch" Margin="28"><Image Width="82" Height="82" Source="avares://ProcWitness/Assets/ProcWitnessIcon.png"/><TextBlock HorizontalAlignment="Center" Margin="0,12,0,6" FontSize="30" FontWeight="Bold" Foreground="#00F3FF" Text="PROCWITNESS TECHNICAL GUIDE"/><TextBlock MaxWidth="1300" HorizontalAlignment="Center" TextAlignment="Center" Classes="body" Margin="0,0,0,24" Text="Local telemetry and prioritization that correlates CPU, RAM, file identity, signatures, connections and behavior over time."/>
          <Border Classes="card"><StackPanel><TextBlock Classes="title" Text="01 • DATA COLLECTION"/><TextBlock Classes="body" Text="• PID, process name and start time&#10;• CPU and physical RAM usage&#10;• File path, creation time and SHA-256&#10;• Windows Authenticode / macOS codesign&#10;• Unavailable capabilities never increase risk"/></StackPanel></Border>
          <Border Classes="card"><StackPanel><TextBlock Classes="title" Text="02 • NETWORK OBSERVATION"/><TextBlock Classes="body" Text="• Windows: ETW bytes + IP Helper&#10;• Linux: /proc socket-to-PID mapping&#10;• macOS: active TCP endpoints via lsof&#10;• Remote endpoints are linked to processes&#10;• Missing telemetry is never treated as zero traffic"/></StackPanel></Border>
          <Border Classes="card"><StackPanel><TextBlock Classes="title" Text="03 • TIMED MONITORING"/><TextBlock Classes="body" Text="• 1, 5, 10, 20 or custom minutes&#10;• New sample about every 4 seconds&#10;• Live countdown&#10;• Previous data is excluded&#10;• Only the exact capture window is reported"/></StackPanel></Border>
          <Border Classes="card"><StackPanel><TextBlock Classes="title" Text="04 • BEHAVIOR ENGINE"/><TextBlock Classes="body" Text="• Sustained or sharply rising CPU&#10;• Heavy work without a visible window&#10;• New files in writable locations&#10;• Signature and network combinations&#10;• PID respawning and unusual traffic"/></StackPanel></Border>
          <Border Classes="card"><StackPanel><TextBlock Classes="title" Text="05 • SMART FILTER"/><TextBlock Classes="body" Text="• Removes stable low-load noise&#10;• Keeps CPU spikes&#10;• Keeps network, recent-file and signature signals&#10;• Preserves PID changes&#10;• Gives AI only meaningful candidates"/></StackPanel></Border>
          <Border Classes="card"><StackPanel><TextBlock Classes="title" Text="06 • REPORT OUTPUTS"/><TextBlock Classes="body" Text="• Chronological telemetry.jsonl&#10;• Correlated analysis-*.json&#10;• Human-readable local report&#10;• Clipboard-ready AI prompt&#10;• Candidates with path and SHA-256"/></StackPanel></Border>
          <Border Classes="card"><StackPanel><TextBlock Classes="title" Text="07 • LIVE RISK SCORING"/><TextBlock Classes="body" Text="• 0–14 Clean  • 15–29 Low&#10;• 30–54 Medium  • 55–79 High&#10;• 80–100 Critical&#10;• CPU ≥ 35% and ≥ 70% are separate thresholds&#10;• Combined findings—not one signal—set the score"/></StackPanel></Border>
          <Border Classes="card"><StackPanel><TextBlock Classes="title" Text="08 • TIME SERIES AND CORRELATION"/><TextBlock Classes="body" Text="• Samples correlate by name + path + SHA-256&#10;• Average, peak and CPU range are calculated&#10;• Peak RAM and first/last seen are retained&#10;• PID count and respawning are tracked&#10;• Example: 5% → sustained 90% behavior is detected"/></StackPanel></Border>
          <Border Classes="card"><StackPanel><TextBlock Classes="title" Text="09 • MINER / EVASION DETECTION"/><TextBlock Classes="body" Text="• Sustained high CPU without a visible window&#10;• Writable path with an unverified publisher&#10;• 20 seconds before Task Manager are analyzed&#10;• Compared with 15 seconds after launch&#10;• A ≥30% load dropping to 5% or one fifth is flagged"/></StackPanel></Border>
          <Border Classes="card"><StackPanel><TextBlock Classes="title" Text="10 • NETWORK AND DATA FLOW"/><TextBlock Classes="body" Text="• Counter deltas are calculated per PID&#10;• Upload ≥ 256 KB: meaningful change&#10;• Upload ≥ 10 MB: strong signal&#10;• Download ≥ 25 MB: attention signal&#10;• Endpoint and process role are interpreted together"/></StackPanel></Border>
          <Border Classes="card"><StackPanel><TextBlock Classes="title" Text="11 • AI EVIDENCE PACKAGE"/><TextBlock Classes="body" Text="• Noise is removed when peak CPU &lt;15% and change &lt;12&#10;• Network, recent-file, signature and PID signals remain&#10;• Candidates are ranked by local risk score&#10;• Only meaningful milestones are included&#10;• AI must report evidence, uncertainty and false positives"/></StackPanel></Border>
          <Border Classes="card"><StackPanel><TextBlock Classes="title" Text="12 • PRIVACY AND LIMITS"/><TextBlock Classes="body" Text="• Evidence stays under ProcWitness/data&#10;• Nothing uploads unless direct AI is enabled and approved&#10;• Retention is configurable&#10;• No quarantine or process termination&#10;• Final decision: hash + publisher + antivirus/EDR"/></StackPanel></Border>
        </StackPanel></ScrollViewer>
      </TabItem>
    </TabControl>
    <Border Grid.Row="3" Background="#090C13" BorderBrush="#3300F3FF" BorderThickness="0,1,0,0" Padding="18,0"><Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto"><Button x:Name="LanguageButton" Grid.Column="0" Padding="10,3" Margin="0,3,10,3" FontSize="11" Content="EN" Click="ToggleLanguage_Click"/><TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="#738198" Text="{Binding VersionText}"/><Button Grid.Column="3" Padding="10,3" Margin="0,3,8,3" FontSize="11" Content="Buy Me a Coffee" Click="OpenSponsor_Click"/><Button Grid.Column="4" Padding="10,3" Margin="0,3" FontSize="11" Foreground="#39FF14" BorderBrush="#39FF14" Content="Teknesyum" Click="OpenGitHub_Click"/></Grid></Border>
  </Grid>
</Window>






