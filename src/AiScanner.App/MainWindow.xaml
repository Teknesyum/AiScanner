<Window x:Class="AiScanner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="AI Scanner" Height="900" Width="1280" MinHeight="750" MinWidth="1180"
        Background="#050508" Foreground="#E0FAFF" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="7" CornerRadius="12" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <SolidColorBrush x:Key="NeonCyan" Color="#00F3FF" />
    <SolidColorBrush x:Key="NeonMagenta" Color="#FF00FF" />
    <SolidColorBrush x:Key="NeonLime" Color="#39FF14" />
    <SolidColorBrush x:Key="Panel" Color="#0B0B12" />
    <SolidColorBrush x:Key="PanelAlt" Color="#11111B" />
    <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    <DropShadowEffect x:Key="NeonTitleGlow" Color="#00F3FF" BlurRadius="18" ShadowDepth="0" Opacity="0.7" />
    <Style TargetType="Button">
      <Setter Property="Background" Value="#100018" />
      <Setter Property="Foreground" Value="{StaticResource NeonCyan}" />
      <Setter Property="BorderBrush" Value="{StaticResource NeonCyan}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="18,9" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Effect">
        <Setter.Value><DropShadowEffect Color="#00F3FF" BlurRadius="12" ShadowDepth="0" Opacity="0.48" /></Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#162936"/><Setter Property="Foreground" Value="White"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#003E48"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#AAB3C7" />
      <Setter Property="Background" Value="#09090F" />
      <Setter Property="Padding" Value="20,12" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="#252536" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}" Margin="0,0,3,0">
              <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#111822"/><Setter Property="Foreground" Value="#E0FAFF"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#0B1118"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="#00F3FF"/><Setter TargetName="TabBorder" Property="BorderThickness" Value="0,0,0,2"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="DataGridRow">
      <Setter Property="Foreground" Value="#D8E3F0" />
      <Setter Property="BorderBrush" Value="#202433" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#12323B"/><Setter Property="Foreground" Value="White"/></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#111E27"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource Panel}" />
      <Setter Property="Foreground" Value="#E0FAFF" />
      <Setter Property="CaretBrush" Value="{StaticResource NeonCyan}" />
      <Setter Property="BorderBrush" Value="#303048" />
      <Setter Property="SelectionBrush" Value="#6600F3FF" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#100018" />
      <Setter Property="Foreground" Value="{StaticResource NeonMagenta}" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="BorderThickness" Value="0,0,1,1" />
      <Setter Property="BorderBrush" Value="#3D164A" />
    </Style>
    <Style TargetType="Hyperlink">
      <Setter Property="Foreground" Value="{StaticResource NeonCyan}" />
      <Setter Property="TextDecorations" Value="{x:Null}" />
      <Setter Property="Cursor" Value="Hand" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource NeonMagenta}"/><Setter Property="TextDecorations" Value="Underline"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="InfoCard" TargetType="Border">
      <Setter Property="Background" Value="#0B0B12" />
      <Setter Property="BorderBrush" Value="#3D00F3FF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="20" />
      <Setter Property="Margin" Value="8" />
      <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#00F3FF" BlurRadius="12" ShadowDepth="0" Opacity="0.16" /></Setter.Value></Setter>
    </Style>
    <Style x:Key="InfoCardTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource NeonCyan}" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="InfoBody" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#B9C4D8" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="LineHeight" Value="21" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
  </Window.Resources>
  <Border Background="#050508" BorderBrush="#24313A" BorderThickness="1" CornerRadius="10">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
      <Border Grid.Row="0" Background="#0B0B12" BorderBrush="#5000F3FF" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid>
          <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
            <Image Width="18" Height="18" Margin="0,0,9,0" Source="Assets/AiScannerIcon.png" />
            <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource NeonCyan}" Text="AI Scanner" />
          </StackPanel>
          <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Width="52" Height="39" Padding="0" BorderThickness="0" Background="Transparent" Effect="{x:Null}" FontSize="17" Click="MinimizeWindow_Click" Content="─" ToolTip="Küçült" />
            <Button Width="52" Height="39" Padding="0" BorderThickness="0" Background="Transparent" Effect="{x:Null}" FontSize="16" Click="ToggleMaximizeWindow_Click" Content="{Binding MaximizeGlyph}" ToolTip="Büyüt / Geri yükle" />
            <Button x:Name="CloseWindowButton" Width="52" Height="39" Padding="0" BorderThickness="0" Background="Transparent" Foreground="{StaticResource NeonMagenta}" Effect="{x:Null}" FontSize="20" Click="CloseWindow_Click" Content="×" ToolTip="Kapat" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1" Margin="28,22,28,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
          <StackPanel>
            <TextBlock FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource NeonCyan}" Text="AI SCANNER" Effect="{DynamicResource NeonTitleGlow}" />
            <TextBlock Margin="0,4,0,0" Foreground="#8892B0" Text="PROCESS INTELLIGENCE // LIVE TELEMETRY" />
          </StackPanel>
          <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
            <Button Click="CreatePrompt_Click" Content="Analiz promptu oluştur" Margin="0,0,10,0"
                    Visibility="{Binding HasCompletedAnalysis, Converter={StaticResource BooleanToVisibility}}" />
            <Button Click="ScanNow_Click" Content="{Binding ScanButtonText}" IsEnabled="{Binding IsCaptureIdle}" MinWidth="145" />
          </StackPanel>
        </Grid>

        <TabControl Grid.Row="1" Margin="0,20,0,0" Background="#050508" Foreground="#E0FAFF" BorderThickness="0">
      <TabItem Header="  Tarama  ">
        <Grid Margin="0,16,0,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border Padding="16" Margin="0,0,0,16" Background="{StaticResource Panel}" BorderBrush="{StaticResource NeonCyan}" BorderThickness="1" CornerRadius="4">
            <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <StackPanel><TextBlock Foreground="#91A0BA" Text="Durum"/><TextBlock FontSize="18" Text="{Binding Status}"/></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Foreground="#91A0BA" Text="Süreç"/><TextBlock FontSize="18" Text="{Binding ProcessCount}"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Foreground="#91A0BA" Text="Yüksek risk"/><TextBlock FontSize="18" Foreground="#FB7185" Text="{Binding HighRiskCount}"/></StackPanel>
        <StackPanel Grid.Column="3"><TextBlock Foreground="#91A0BA" Text="Son tarama"/><TextBlock FontSize="18" Text="{Binding LastScanText}"/></StackPanel>
            </Grid>
          </Border>
          <DataGrid Grid.Row="1" ItemsSource="{Binding Assessments}" SelectedItem="{Binding SelectedAssessment}" MouseDoubleClick="ProcessGrid_MouseDoubleClick"
              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
              Background="{StaticResource Panel}" Foreground="#E0FAFF" BorderBrush="#25323A"
              RowBackground="{StaticResource Panel}" AlternatingRowBackground="{StaticResource PanelAlt}" GridLinesVisibility="Horizontal">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Risk" Binding="{Binding Level}" Width="90" />
        <DataGridTextColumn Header="Skor" Binding="{Binding Score}" Width="70" />
        <DataGridTextColumn Header="Süreç" Binding="{Binding Process.Name}" Width="170" />
        <DataGridTextColumn Header="PID" Binding="{Binding Process.ProcessId}" Width="75" />
        <DataGridTextColumn Header="CPU" Binding="{Binding Process.CpuPercent, StringFormat={}{0:F1}%}" Width="85" />
        <DataGridTextColumn Header="RAM" Binding="{Binding Process.WorkingSetBytes}" Width="110" />
        <DataGridTextColumn Header="↑ MB" Binding="{Binding Process.SentMegabytes, StringFormat={}{0:F2}}" Width="80" />
        <DataGridTextColumn Header="↓ MB" Binding="{Binding Process.ReceivedMegabytes, StringFormat={}{0:F2}}" Width="80" />
        <DataGridTextColumn Header="Bağlantı" Binding="{Binding Process.ActiveConnections}" Width="85" />
        <DataGridTextColumn Header="Bulgular" Binding="{Binding FindingsSummary}" Width="*" />
      </DataGrid.Columns>
          </DataGrid>
          <Border Grid.Row="2" Margin="0,16,0,0" Padding="14" Background="{StaticResource Panel}" BorderBrush="{StaticResource NeonMagenta}" BorderThickness="1" CornerRadius="4">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="Seçili süreç ayrıntısı" />
                <TextBlock Margin="0,6,14,0" Foreground="#AAB6CA" TextWrapping="Wrap" Text="{Binding SelectedDetails}" />
              </StackPanel>
              <Button Grid.Column="1" VerticalAlignment="Center" Click="OpenProcessLocation_Click" Content="Dosya konumunu aç" />
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="  Süreli Analiz  ">
        <Grid Margin="0,16,0,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock VerticalAlignment="Center" Margin="0,0,10,0" Text="Analiz aralığı:" />
            <Button Click="Duration_Click" Tag="1" Content="1 dk" Margin="0,0,6,0" />
            <Button Click="Duration_Click" Tag="5" Content="5 dk" Margin="0,0,6,0" />
            <Button Click="Duration_Click" Tag="10" Content="10 dk" Margin="0,0,6,0" />
            <Button Click="Duration_Click" Tag="20" Content="20 dk" Margin="0,0,10,0" />
            <TextBox x:Name="CustomMinutes" Width="58" Margin="0,0,6,0" Padding="7" Text="60" Background="#12192B" Foreground="White" BorderBrush="#29324A" />
            <Button Click="CustomDuration_Click" Content="Özel dk" />
          </StackPanel>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Click="OpenDataFolder_Click" Content="Veri klasörünü aç" Margin="0,0,14,0" />
            <TextBlock VerticalAlignment="Center" Foreground="#91A0BA" Text="{Binding PromptStatus}" />
          </StackPanel>
          <TextBox Grid.Row="2" Text="{Binding LocalAnalysisReport, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                   VerticalScrollBarVisibility="Auto" Padding="12" />
          <TextBlock Grid.Row="3" Margin="0,14,0,8" Foreground="#91A0BA" TextWrapping="Wrap" Text="Bu rapor uygulamanın kendi algoritması tarafından üretildi. AI yalnızca hazır bulguları yorumlar." />
        </Grid>
      </TabItem>

      <TabItem Header="  Bilgi  ">
        <ScrollViewer Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel MaxWidth="1080" HorizontalAlignment="Center" Margin="12,0,12,28">
            <Image Width="76" Height="76" Source="Assets/AiScannerIcon.png" HorizontalAlignment="Center" />
            <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" FontSize="30" FontWeight="Bold" Foreground="{StaticResource NeonCyan}" Text="AI SCANNER TEKNİK REHBERİ" Effect="{DynamicResource NeonTitleGlow}" />
            <TextBlock MaxWidth="820" Margin="0,10,0,20" TextAlignment="Center" TextWrapping="Wrap" Foreground="#AEBBD0" FontSize="14" LineHeight="22"
                       Text="Süreçleri yalnızca isimlerine göre yargılamayan; kaynak kullanımı, ağ trafiği, dosya kimliği ve zaman içindeki davranışı birlikte inceleyen yerel telemetri ve erken uyarı sistemi." />

            <UniformGrid Columns="2">
              <Border Style="{StaticResource InfoCard}">
                <StackPanel>
                  <TextBlock Style="{StaticResource InfoCardTitle}" Text="01  VERİ TOPLAMA • 8 ARAÇ" />
                  <TextBlock Style="{StaticResource InfoBody}" Text="① Süreç kimliği — PID, süreç adı, başlangıç zamanı ve çalışan örneği belirlenir." />
                  <TextBlock Style="{StaticResource InfoBody}" Text="② CPU örnekleyici — İki ölçüm arasındaki işlemci zamanı mantıksal çekirdek sayısına göre yüzdeye çevrilir." />
                  <TextBlock Style="{StaticResource InfoBody}" Text="③ Bellek ölçer — Sürecin fiziksel çalışma kümesi bayt olarak kaydedilir; dönem tepe RAM değeri hesaplanır." />
                  <TextBlock Style="{StaticResource InfoBody}" Text="④ Dosya çözücü — Çalıştırılabilir dosyanın tam yolu ve oluşturulma zamanı okunur." />
                  <TextBlock Style="{StaticResource InfoBody}" Text="⑤ SHA-256 motoru — Aynı dosyayı farklı PID ve zamanlarda ilişkilendiren kriptografik özet üretilir." />
                  <TextBlock Style="{StaticResource InfoBody}" Text="⑥ İmza doğrulayıcı — Sertifika zinciri kurulur, yayıncı okunur; yalnızca imza bulunması güvenli kabul edilmez." />
                  <TextBlock Style="{StaticResource InfoBody}" Text="⑦ Pencere gözlemcisi — Sürecin görünür ana penceresi olup olmadığı belirlenir." />
                  <TextBlock Style="{StaticResource InfoBody}" Text="⑧ Ağ toplayıcısı — ETW ile süreç başına TCP/IP gönderilen/alınan baytlar; IP Helper ile aktif uzak uç noktalar izlenir." />
                </StackPanel>
              </Border>

              <Border Style="{StaticResource InfoCard}" BorderBrush="#55FF00FF">
                <StackPanel>
                  <TextBlock Style="{StaticResource InfoCardTitle}" Foreground="{StaticResource NeonMagenta}" Text="02  ÖLÇÜM OTURUMU • 5 MEKANİZMA" />
                  <TextBlock Style="{StaticResource InfoBody}" Text="① Sıfırdan başlatma — Süre düğmesine basıldığı an başlangıç damgası alınır; geçmiş kayıtlar oturuma dahil edilmez." />
                  <TextBlock Style="{StaticResource InfoBody}" Text="② Kesin süre — 1, 5, 10, 20 veya özel dakika boyunca geri sayım yapılır; süre dolmadan rapor oluşturulmaz." />
                  <TextBlock Style="{StaticResource InfoBody}" Text="③ Canlı örnekleme — Yaklaşık dört saniyede bir bütün süreç tablosu yenilenir. Oturum sırasında her döngü kalıcı kayda alınır." />
                  <TextBlock Style="{StaticResource InfoBody}" Text="④ Örnek izolasyonu — Her çalışan AI Scanner benzersiz toplayıcı kimliği kullanır; başka açık kopyanın verisi rapora karışmaz." />
                  <TextBlock Style="{StaticResource InfoBody}" Text="⑤ Kesin pencere — Analiz yalnızca gerçek başlangıç ve tamamlanma damgaları arasındaki gözlemleri okur." />
                </StackPanel>
              </Border>

              <Border Style="{StaticResource InfoCard}" BorderBrush="#5539FF14">
                <StackPanel>
                  <TextBlock Style="{StaticResource InfoCardTitle}" Foreground="{StaticResource NeonLime}" Text="03  CANLI RİSK • 8 SİNYAL" />
                  <TextBlock Style="{StaticResource InfoBody}" Text="① İmzasız dosya +15 — Doğrulanabilir yayıncı zinciri bulunmayan çalıştırılabilir dosya." />
                  <TextBlock Style="{StaticResource InfoBody}" Text="② Yazılabilir dizin +15 — Temp veya kullanıcı uygulama verisi gibi değiştirilebilir konumdan çalışma." />
                  <TextBlock Style="{StaticResource InfoBody}" Text="③ CPU %35–69 +10; CPU %70+ +20 — Anlık yoğun işlemci kullanımı." />
                  <TextBlock Style="{StaticResource InfoBody}" Text="④ Gizli yüksek yük +10 — Görünür pencere olmadan en az %35 CPU kullanımı." />
                  <TextBlock Style="{StaticResource InfoBody}" Text="⑤ İmzasız ağ süreci +20 — İmzasız dosyanın etkin uzak bağlantı kurması." />
                  <TextBlock Style="{StaticResource InfoBody}" Text="⑥ Yeni ağ dosyası +15 — Son yedi günde oluşturulan dosyanın dış bağlantı kullanması." />
                  <TextBlock Style="{StaticResource InfoBody}" Text="⑦ Arka plan upload +20 — Görünür pencere olmadan izleme başlangıcından beri en az 10 MB gönderim." />
                  <TextBlock Style="{StaticResource InfoBody}" Text="⑧ Görev Yöneticisi kaçınması +30 — Açılış öncesi yüksek CPU'nun hemen ardından keskin düşüş göstermesi." />
                </StackPanel>
              </Border>

              <Border Style="{StaticResource InfoCard}" BorderBrush="#559D00FF">
                <StackPanel>
                  <TextBlock Style="{StaticResource InfoCardTitle}" Foreground="#C779FF" Text="04  SÜRELİ KORELASYON • 7 ANALİZ" />
                  <TextBlock Style="{StaticResource InfoBody}" Text="① Dosya kimliği — Ad + yol + SHA-256 ile dönem boyunca tek davranış profili oluşturulur." />
                  <TextBlock Style="{StaticResource InfoBody}" Text="② Sürekli CPU — Ortalama en az %35 ve tepe en az %70 ise +25 dönem skoru." />
                  <TextBlock Style="{StaticResource InfoBody}" Text="③ CPU sıçraması — Tepe en az %40 ve dönem aralığı en az 25 puansa +15." />
                  <TextBlock Style="{StaticResource InfoBody}" Text="④ Ağ farkı — İlk/son ETW sayaçları çıkarılır; 256 KB upload +8, 10 MB upload +20, 25 MB download +8." />
                  <TextBlock Style="{StaticResource InfoBody}" Text="⑤ İmza-ağ birleşimi — İmzasız dosya bağlantı kurarsa +25; yeni dosya bağlantı kurarsa +20." />
                  <TextBlock Style="{StaticResource InfoBody}" Text="⑥ Gizli faaliyet — Penceresiz süreçte %35+ CPU veya 1 MB+ upload varsa +15." />
                  <TextBlock Style="{StaticResource InfoBody}" Text="⑦ Yeniden doğuş — Aynı dosya birden fazla PID ile görünürse +10; PID sayısı rapora yazılır." />
                </StackPanel>
              </Border>

              <Border Style="{StaticResource InfoCard}">
                <StackPanel>
                  <TextBlock Style="{StaticResource InfoCardTitle}" Text="05  AKILLI FİLTRE • 6 ÖLÇÜT" />
                  <TextBlock Style="{StaticResource InfoBody}" Text="Bir sürecin AI/yerel dönem raporuna girmesi için şu sinyallerden en az biri aranır:" />
                  <TextBlock Style="{StaticResource InfoBody}" Text="① CPU tepe değeri %15 veya üzeri. ② CPU aralığı en az 12 puan. ③ Upload en az 256 KB." />
                  <TextBlock Style="{StaticResource InfoBody}" Text="④ Download en az 1 MB. ⑤ İmzasız etkin ağ bağlantısı veya son yedi günde oluşturulmuş dosya. ⑥ Aynı dosyanın birden fazla PID ile çalışması." />
                  <TextBlock Style="{StaticResource InfoBody}" Foreground="#E8F2FF" Text="Neden? Sabit %5–6 CPU kullanan, ağ üretmeyen ve başka riski olmayan yüzlerce normal süreç raporu boğmaz. Düşük CPU'lu casus yazılım ise ağ/imza/dosya sinyali taşıdığı için korunur." />
                </StackPanel>
              </Border>

              <Border Style="{StaticResource InfoCard}" BorderBrush="#55FF00FF">
                <StackPanel>
                  <TextBlock Style="{StaticResource InfoCardTitle}" Foreground="{StaticResource NeonMagenta}" Text="06  RAPORLAMA • 4 ÇIKTI" />
                  <TextBlock Style="{StaticResource InfoBody}" Text="① Yerel okunabilir rapor — En yüksek skorlu 20 aday; yol, CPU ort/tepe, RAM, upload/download ve gerekçeler." />
                  <TextBlock Style="{StaticResource InfoBody}" Text="② Rehberli JSON — Meta bilgi, süreç özetleri, anlamlı zaman noktaları ve yalnızca gerekli ham gözlemler." />
                  <TextBlock Style="{StaticResource InfoBody}" Text="③ AI promptu — Yerel motorun işi bitirdiğini, AI'ın yalnızca doğrulama ve uzman yorumu yapacağını açıklayan hazır talimat." />
                  <TextBlock Style="{StaticResource InfoBody}" Text="④ Dosya talebi — Statik inceleme gerekirse AI tam yol ve SHA-256 ile hangi dosyanın ayrıca yüklenmesi gerektiğini bildirir." />
                </StackPanel>
              </Border>

              <Border Style="{StaticResource InfoCard}" BorderBrush="#55FFB000">
                <StackPanel>
                  <TextBlock Style="{StaticResource InfoCardTitle}" Foreground="#FFCA55" Text="07  SKOR VE YORUM" />
                  <TextBlock Style="{StaticResource InfoBody}" Text="Canlı skor: 0–14 Temiz, 15–29 Düşük, 30–54 Orta, 55–79 Yüksek, 80–100 Kritik." />
                  <TextBlock Style="{StaticResource InfoBody}" Text="Süreli skor birleşik davranış puanıdır ve 100'de sınırlandırılır. Aynı süreç birden çok bağımsız sinyal taşıdığında önceliği yükselir." />
                  <TextBlock Style="{StaticResource InfoBody}" Text="Skor 'zararlıdır' hükmü değildir. Amaç hangi dosyanın neden incelenmesi gerektiğini açıklanabilir biçimde sıralamaktır." />
                </StackPanel>
              </Border>

              <Border Style="{StaticResource InfoCard}" BorderBrush="#55FF5555">
                <StackPanel>
                  <TextBlock Style="{StaticResource InfoCardTitle}" Foreground="#FF7474" Text="08  GÜVENLİK • 6 SINIR" />
                  <TextBlock Style="{StaticResource InfoBody}" Text="① Süreç otomatik sonlandırılmaz. ② Dosya silinmez veya karantinaya alınmaz. ③ Veri kendiliğinden internete gönderilmez." />
