<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="AiScanner.App.MainWindow"
        Title="AI Scanner" Width="1280" Height="860" MinWidth="1000" MinHeight="680" Background="#050509" Foreground="#E6FAFF" WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="Button"><Setter Property="Background" Value="#111522"/><Setter Property="Foreground" Value="#00F3FF"/><Setter Property="BorderBrush" Value="#00F3FF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,9"/><Setter Property="CornerRadius" Value="5"/></Style>
    <Style Selector="Button:pointerover"><Setter Property="Background" Value="#15303B"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="TextBox"><Setter Property="Background" Value="#0B0E16"/><Setter Property="Foreground" Value="#E6FAFF"/><Setter Property="BorderBrush" Value="#304050"/></Style>
    <Style Selector="TabItem"><Setter Property="Foreground" Value="#AAB6C8"/><Setter Property="Padding" Value="22,13"/></Style>
    <Style Selector="TabItem:selected"><Setter Property="Foreground" Value="#00F3FF"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style Selector="Border.card"><Setter Property="Background" Value="#0B0E16"/><Setter Property="BorderBrush" Value="#304050"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
    <Style Selector="TextBlock.title"><Setter Property="Foreground" Value="#00F3FF"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="19"/></Style>
    <Style Selector="TextBlock.body"><Setter Property="Foreground" Value="#C5D0E0"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="16"/><Setter Property="LineHeight" Value="25"/><Setter Property="Margin" Value="0,8,0,0"/></Style>
    <Style Selector="TextBlock.step"><Setter Property="Foreground" Value="#E8F8FF"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="17"/><Setter Property="LineHeight" Value="27"/></Style>
  </Window.Styles>
  <Grid RowDefinitions="64,Auto,*,38">
    <Border Grid.Row="0" Background="#090C13" BorderBrush="#3300F3FF" BorderThickness="0,0,0,1" Padding="22,0">
      <Grid ColumnDefinitions="Auto,*,Auto"><Image Width="38" Height="38" Source="avares://AiScanner/Assets/AiScannerIcon.png" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center"><TextBlock FontSize="22" FontWeight="Bold" Foreground="#00F3FF" Text="AI SCANNER"/><TextBlock Foreground="#718097" Text="CROSS-PLATFORM PROCESS INTELLIGENCE"/></StackPanel><TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="#39FF14" Text="●  {Binding Status}"/></Grid>
    </Border>
    <Border Grid.Row="1" IsVisible="{Binding IsPromptNotificationVisible}" Background="#122D1B" BorderBrush="#39FF14" BorderThickness="1" CornerRadius="6" Margin="18,8,18,0" Padding="14,10"><TextBlock HorizontalAlignment="Center" FontSize="15" FontWeight="Bold" Foreground="#7CFF68" Text="✓ Analiz promptu panoya kopyalandı"/></Border>
    <TabControl Grid.Row="2" Margin="18,8">
      <TabItem Header="Tarama">
        <Grid RowDefinitions="Auto,*,Auto" Margin="0,12,0,0">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto"><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12"><TextBlock Foreground="#8997AB" Text="{Binding SummaryText}"/><TextBlock Foreground="#66758C" Text="{Binding PromptStatus}"/></StackPanel><Button Grid.Column="1" Margin="8,0" Content="{Binding ScanButtonText}" Click="ScanNow_Click"/><Button x:Name="DurationMenuButton" Grid.Column="2" Margin="0,0,8,0" Content="Süreli Analiz ▼"><Button.Flyout><Flyout Placement="BottomEdgeAlignedRight"><StackPanel Width="300" Spacing="10"><TextBlock FontSize="17" FontWeight="Bold" Foreground="#00F3FF" Text="Analiz süresini seçin"/><TextBlock FontSize="12" Foreground="#91A0BA" TextWrapping="Wrap" Text="Seçimden sonra pencere kapanır ve geri sayım Şimdi Tara düğmesinde görünür."/><UniformGrid Columns="2" Rows="2"><Button Tag="1" Margin="3" Content="1 dakika" Click="Duration_Click"/><Button Tag="5" Margin="3" Content="5 dakika" Click="Duration_Click"/><Button Tag="10" Margin="3" Content="10 dakika" Click="Duration_Click"/><Button Tag="20" Margin="3" Content="20 dakika" Click="Duration_Click"/></UniformGrid><Grid ColumnDefinitions="*,Auto"><TextBox x:Name="CustomMinutes" PlaceholderText="Özel dakika"/><Button Grid.Column="1" Margin="8,0,0,0" Content="Başlat" Click="CustomDuration_Click"/></Grid><Button Content="Veri klasörünü aç" Click="OpenDataFolder_Click"/></StackPanel></Flyout></Button.Flyout></Button><Button Grid.Column="3" Content="{Binding PromptButtonText}" Background="{Binding PromptButtonBackground}" Foreground="{Binding PromptButtonForeground}" BorderBrush="{Binding PromptButtonBorder}" IsVisible="{Binding HasCompletedAnalysis}" Click="CreatePrompt_Click"/></Grid>
          <Grid Grid.Row="1" RowDefinitions="32,*" Margin="0,14">
            <Border Background="#111522" BorderBrush="#304050" BorderThickness="0,0,0,1" Padding="8,0"><Grid ColumnDefinitions="55,155,65,85,75,75,55,60,75,140,*"><TextBlock FontSize="11" VerticalAlignment="Center" Text="PID"/><TextBlock Grid.Column="1" FontSize="11" VerticalAlignment="Center" Text="SÜREÇ"/><TextBlock Grid.Column="2" FontSize="11" VerticalAlignment="Center" Text="CPU"/><TextBlock Grid.Column="3" FontSize="11" VerticalAlignment="Center" Text="RAM"/><TextBlock Grid.Column="4" FontSize="11" VerticalAlignment="Center" Text="UPLOAD"/><TextBlock Grid.Column="5" FontSize="11" VerticalAlignment="Center" Text="DOWNLOAD"/><TextBlock Grid.Column="6" FontSize="11" VerticalAlignment="Center" Text="AĞ"/><TextBlock Grid.Column="7" FontSize="11" VerticalAlignment="Center" Text="SKOR"/><TextBlock Grid.Column="8" FontSize="11" VerticalAlignment="Center" Text="RİSK"/><TextBlock Grid.Column="9" FontSize="11" VerticalAlignment="Center" Text="YAYINCI"/><TextBlock Grid.Column="10" FontSize="11" VerticalAlignment="Center" Text="BULGULAR / DOSYA YOLU"/></Grid></Border>
            <ListBox Grid.Row="1" ItemsSource="{Binding Assessments}" SelectedItem="{Binding SelectedAssessment}" FontSize="11"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#18202C" BorderThickness="0,0,0,1" Padding="8,2"><Grid ColumnDefinitions="55,155,65,85,75,75,55,60,75,140,*"><TextBlock Text="{Binding Process.ProcessId}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Process.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Cursor="Hand" PointerPressed="ProcessName_PointerPressed" ToolTip.Tip="Dosya konumunu aç"/><TextBlock Grid.Column="2" Text="{Binding Process.CpuPercent, StringFormat={}{0:F1}%}" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{Binding Process.WorkingSetBytes, StringFormat={}{0:N0} B}" VerticalAlignment="Center"/><TextBlock Grid.Column="4" Text="{Binding Process.SentMegabytes, StringFormat={}{0:F2} MB}" VerticalAlignment="Center"/><TextBlock Grid.Column="5" Text="{Binding Process.ReceivedMegabytes, StringFormat={}{0:F2} MB}" VerticalAlignment="Center"/><TextBlock Grid.Column="6" Text="{Binding Process.ActiveConnections}" VerticalAlignment="Center"/><TextBlock Grid.Column="7" Text="{Binding Score}" FontWeight="Bold" Foreground="{Binding RiskColor}" VerticalAlignment="Center"/><TextBlock Grid.Column="8" Text="{Binding Level}" FontWeight="Bold" Foreground="{Binding RiskColor}" VerticalAlignment="Center"/><TextBlock Grid.Column="9" Text="{Binding Process.Publisher}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="10" Text="{Binding FindingsSummary}" Foreground="{Binding RiskColor}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
          </Grid>
          <Border Grid.Row="2" Classes="card" IsVisible="{Binding IsTimedReportVisible}" BorderBrush="#5539FF14"><StackPanel><TextBlock Classes="title" Foreground="#7CFF68" Text="SÜRELİ ANALİZ RAPORU"/><TextBox Margin="0,10,0,0" MaxHeight="230" Text="{Binding LocalAnalysisReport}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"/></StackPanel></Border>
        </Grid>
      </TabItem>
      <TabItem Header="Nasıl Kullanılır?">
        <ScrollViewer><Viewbox Stretch="Uniform" StretchDirection="UpOnly" HorizontalAlignment="Center" MaxWidth="1250"><StackPanel Width="1000" Margin="24">
          <TextBlock HorizontalAlignment="Center" FontSize="30" FontWeight="Bold" Foreground="#39FF14" Text="5 ADIMDA AI SCANNER"/>
          <TextBlock Margin="0,8,0,24" HorizontalAlignment="Center" Foreground="#AAB8CA" FontSize="16" Text="Tarama ve AI raporu için kısa kullanım rehberi"/>
          <Border Classes="card" BorderBrush="#00F3FF"><TextBlock Classes="step"><Run Foreground="#00F3FF" FontWeight="Bold" Text="1 • ŞİMDİ TARA  "/><Run Text="Tarama sekmesindeki düğmeye basın. Çalışan süreçler yerel olarak incelenir. Bir süreci seçerek yolunu, SHA-256 değerini ve yayıncısını görün."/></TextBlock></Border>
          <Border Classes="card" BorderBrush="#C779FF"><TextBlock Classes="step"><Run Foreground="#C779FF" FontWeight="Bold" Text="2 • SÜRELİ DİNLE  "/><Run Text="Süreli Analiz sekmesinden 1, 5, 10, 20 veya özel dakika seçin. Program süre dolana kadar veri toplar. Miner ve aralıklı casus yazılım davranışları için 10–20 dakika önerilir."/></TextBlock></Border>
          <Border Classes="card" BorderBrush="#FFB000"><TextBlock Classes="step"><Run Foreground="#FFCA55" FontWeight="Bold" Text="3 • YEREL RAPORU OKU  "/><Run Text="Süre bitince önemsiz ve kararlı süreçler elenir. Yüksek puan kesin zararlı demek değildir; önce incelenmesi gereken adayı gösterir."/></TextBlock></Border>
          <Border Classes="card" BorderBrush="#39FF14"><TextBlock Classes="step"><Run Foreground="#7CFF68" FontWeight="Bold" Text="4 • PROMPTU KOPYALA  "/><Run Text="Analiz için prompt oluştur düğmesine basın. Düğme yeşile döner ve kopyalandığını bildirir. Promptu Codex veya başka bir AI’a yapıştırın."/></TextBlock></Border>
          <Border Classes="card" BorderBrush="#FF647C"><TextBlock Classes="step"><Run Foreground="#FF8295" FontWeight="Bold" Text="5 • GÜVENLİ DOĞRULA  "/><Run Text="AI dosya isterse promptta yolu yazan analysis-*.json dosyasını yükleyin. Yol, yayıncı ve SHA-256 değerini doğrulamadan dosya silmeyin veya süreç sonlandırmayın."/></TextBlock></Border>
        </StackPanel></Viewbox></ScrollViewer>
      </TabItem>
      <TabItem Header="Bilgi">
        <ScrollViewer><StackPanel MaxWidth="1500" HorizontalAlignment="Stretch" Margin="28"><Image Width="82" Height="82" Source="avares://AiScanner/Assets/AiScannerIcon.png"/><TextBlock HorizontalAlignment="Center" Margin="0,12,0,6" FontSize="30" FontWeight="Bold" Foreground="#00F3FF" Text="AI SCANNER TEKNİK REHBERİ"/><TextBlock MaxWidth="1300" HorizontalAlignment="Center" TextAlignment="Center" Classes="body" Margin="0,0,0,24" Text="CPU, RAM, dosya kimliği, imza, bağlantı ve zaman içindeki davranışı birlikte inceleyen yerel telemetri ve önceliklendirme sistemi."/>
          <Border Classes="card"><StackPanel><TextBlock Classes="title" Text="01 • VERİ TOPLAMA"/><TextBlock Classes="body" Text="PID, süreç adı, başlangıç zamanı, çalıştırılabilir dosya yolu, SHA-256, dosya oluşturma zamanı, CPU ve RAM her örnekte kaydedilir. Windows Authenticode, macOS codesign doğrulaması kullanır. Linux’ta standart imza zinciri yoksa sonuç ölçülemedi olarak tutulur; imzasız diye yanlış puanlanmaz."/></StackPanel></Border>
          <Border Classes="card"><StackPanel><TextBlock Classes="title" Text="02 • AĞ GÖZLEMİ"/><TextBlock Classes="body" Text="Windows ETW ile süreç başına gönderilen/alınan baytları ve IP Helper ile bağlantıları ölçer. Linux /proc soketlerini PID’lerle eşler. macOS lsof ile etkin TCP uçlarını çözer. Bayt telemetrisi yoksa sıfır trafik varsayılmaz."/></StackPanel></Border>
          <Border Classes="card"><StackPanel><TextBlock Classes="title" Text="03 • SÜRELİ DİNLEME"/><TextBlock Classes="body" Text="Seçtiğiniz anda yeni bir oturum başlar. Yaklaşık dört saniyede bir örnek alınır, geri sayım görünür ve yalnızca gerçek başlangıç-bitiş aralığı rapora dahil edilir."/></StackPanel></Border>
          <Border Classes="card"><StackPanel><TextBlock Classes="title" Text="04 • DAVRANIŞ MOTORU"/><TextBlock Classes="body" Text="Sürekli veya yükselen CPU, yazılabilir konumdaki yeni dosyalar, imza-ağ birleşimi, gizli yoğun yük, sıra dışı trafik, yeniden doğan PID ve Windows Görev Yöneticisi açılınca ani yük düşüşü gibi bağımsız sinyaller puanlanır."/></StackPanel></Border>
          <Border Classes="card"><StackPanel><TextBlock Classes="title" Text="05 • AKILLI FİLTRE"/><TextBlock Classes="body" Text="Düşük ve değişmeyen yük üreten normal süreçler AI paketinden çıkarılır. CPU sıçraması, ağ, yeni dosya, imza veya PID değişimi taşıyan düşük CPU’lu adaylar korunur; AI gereksiz veriyle boğulmaz."/></StackPanel></Border>
          <Border Classes="card"><StackPanel><TextBlock Classes="title" Text="06 • RAPOR VE GÜVENLİK"/><TextBlock Classes="body" Text="Yerel JSONL günlük, korelasyonlu analiz paketi, okunabilir rapor ve panoya hazır prompt üretir. Dosya silmez, süreç sonlandırmaz ve veriyi kendiliğinden internete göndermez. Bu araç antivirüs hükmü değil, açıklanabilir inceleme önceliğidir."/></StackPanel></Border>
          <Border Classes="card"><StackPanel><TextBlock Classes="title" Text="07 • CANLI RİSK PUANLAMA"/><TextBlock Classes="body" Text="Her süreç tek bir belirtiyle yargılanmaz. Doğrulanamayan imza, kullanıcı tarafından yazılabilir Temp/AppData benzeri dizinlerden çalışma, yüzde 35 ve üzeri CPU, görünür pencere olmadan yoğun yük, dış ağ bağlantısı, yakın zamanda oluşturulmuş çalıştırılabilir dosya ve yüksek arka plan upload davranışı ayrı bulgular olarak hesaplanır. Bağımsız bulguların puanları birleşir: 0–14 Temiz, 15–29 Düşük, 30–54 Orta, 55–79 Yüksek ve 80–100 Kritik. Platform bir özelliği ölçemiyorsa o özellik risk kanıtı sayılmaz."/></StackPanel></Border>
          <Border Classes="card"><StackPanel><TextBlock Classes="title" Text="08 • ZAMAN SERİSİ VE KORELASYON"/><TextBlock Classes="body" Text="Süreli analiz yalnızca son ekrandaki değeri okumaz. Aynı dosyanın bütün örnekleri ad, tam yol ve SHA-256 kimliğiyle birleştirilir. Ortalama CPU, tepe CPU, en düşük–en yüksek aralık, tepe RAM, ilk/son görülme, farklı PID sayısı, aktif bağlantılar ve uzak uç noktalar hesaplanır. Sürekli yüksek CPU, ani sıçrama, ağ sayacı farkı, aynı dosyanın yeni PID ile tekrar doğması ve görünür pencere olmadan kaynak tüketmesi birlikte değerlendirilir. Böylece ilk dakikada yüzde 5 kullanıp sonraki dokuz dakika yüzde 90 çalışan bir süreç dönem davranışıyla görünür hale gelir."/></StackPanel></Border>
          <Border Classes="card"><StackPanel><TextBlock Classes="title" Text="09 • MINER VE GÖREV YÖNETİCİSİ KAÇINMASI"/><TextBlock Classes="body" Text="Miner benzeri süreçler için yüksek ve sürekli CPU, penceresiz çalışma, kullanıcı yazılabilir dizinden başlama, doğrulanamayan yayıncı ve süreç yeniden doğuşu aranır. Windows Görev Yöneticisi açıldığında izlenen bir sürecin önceki 20 saniyedeki CPU ortalamasıyla sonraki 15 saniyedeki ortalaması karşılaştırılır. Önceden en az yüzde 30 yük üretip açılıştan sonra yaklaşık beşte birine veya yüzde 5 altına düşen davranış ayrı ve yüksek ağırlıklı kaçınma sinyali oluşturur. Bu sinyal tek başına zararlı hükmü değildir; dosya kimliği ve diğer davranışlarla doğrulanır."/></StackPanel></Border>
          <Border Classes="card"><StackPanel><TextBlock Classes="title" Text="10 • AĞ VE VERİ AKIŞI ANALİZİ"/><TextBlock Classes="body" Text="Windows’ta ETW etkin olduğunda her PID için gerçek gönderilen ve alınan TCP/IP bayt sayaçları tutulur; süreli raporda ilk ve son sayaç farkları PID bazında toplanır. 256 KB üzeri upload anlamlı değişim, 10 MB üzeri upload yüksek sinyal, 25 MB üzeri download ise dikkat sinyali üretir. Aktif uzak adres ve portlar süreçle ilişkilendirilir. Linux ve macOS’ta standart kullanıcı yetkisi süreç başına bayt sayacı sağlamıyorsa bağlantılar yine raporlanır fakat 0 B değeri güven kanıtı kabul edilmez. Böylece normalde ağ kullanmaması beklenen bir editörün bağlantıları AI raporunda bağlamıyla sorgulanabilir."/></StackPanel></Border>
          <Border Classes="card"><StackPanel><TextBlock Classes="title" Text="11 • AI İÇİN VERİ AZALTMA VE PAKETLEME"/><TextBlock Classes="body" Text="AI’a bütün süreç tablosu körlemesine verilmez. Tepe CPU yüzde 15’in altındaysa, CPU değişimi 12 puandan azsa, anlamlı trafik/bağlantı, yeni dosya, imza riski veya PID değişimi yoksa kararlı süreç paketten çıkarılır. Korunan adaylar risk skoruna göre sıralanır; en anlamlı zaman noktaları CPU veya bağlantı değişimlerinde seçilir. Paket; okuma sırası, alan açıklamaları, platform kabiliyetleri, yerel bulgular, anonimleştirilmiş kullanıcı yolu, SHA-256, süreç özetleri ve gerekli ham örnekleri içerir. Prompt AI’a dosya adlarını talimat değil güvenilmeyen veri kabul etmesini, belirsizlikleri ve yanlış pozitifleri açıkça yazmasını söyler."/></StackPanel></Border>
          <Border Classes="card"><StackPanel><TextBlock Classes="title" Text="12 • YEREL KAYIT, MAHREMİYET VE SINIRLAR"/><TextBlock Classes="body" Text="Telemetri işletim sisteminin yerel uygulama-verisi klasöründeki AiScanner/data altında JSONL olarak saklanır. Her çalışan uygulama örneği benzersiz toplayıcı kimliği kullanır; başka açık kopyanın kayıtları süreli oturuma karışmaz. Günlük 256 MB sınırını aşarsa son yedi günlük geçerli kayıtlar korunarak sıkıştırılır. Prompt panoya kopyalanır ve ayrıca dosyaya yazılır; uygulama hiçbir kaydı kendiliğinden buluta göndermez. AI Scanner dosya silmez, karantinaya almaz veya süreç sonlandırmaz. Son karar için yayıncı, hash, antivirüs/EDR sonucu ve gerektiğinde kontrollü statik analiz birlikte kullanılmalıdır."/></StackPanel></Border>
        </StackPanel></ScrollViewer>
      </TabItem>
    </TabControl>
    <Border Grid.Row="3" Background="#090C13" BorderBrush="#3300F3FF" BorderThickness="0,1,0,0" Padding="18,0"><Grid ColumnDefinitions="Auto,*,Auto,Auto"><TextBlock VerticalAlignment="Center" Foreground="#738198" Text="{Binding VersionText}"/><Button Grid.Column="2" Padding="10,3" Margin="0,3,8,3" FontSize="11" Content="Buy Me a Coffee" Click="OpenSponsor_Click"/><Button Grid.Column="3" Padding="10,3" Margin="0,3" FontSize="11" Foreground="#39FF14" BorderBrush="#39FF14" Content="Teknesyum" Click="OpenGitHub_Click"/></Grid></Border>
  </Grid>
</Window>
