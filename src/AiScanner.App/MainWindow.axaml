<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="AiScanner.App.MainWindow"
        Title="AI Scanner" Width="1280" Height="860" MinWidth="1000" MinHeight="680" Background="#050509" Foreground="#E6FAFF" WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="Button"><Setter Property="Background" Value="#111522"/><Setter Property="Foreground" Value="#00F3FF"/><Setter Property="BorderBrush" Value="#00F3FF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,9"/><Setter Property="CornerRadius" Value="5"/></Style>
    <Style Selector="Button:pointerover"><Setter Property="Background" Value="#15303B"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="TextBox"><Setter Property="Background" Value="#0B0E16"/><Setter Property="Foreground" Value="#E6FAFF"/><Setter Property="BorderBrush" Value="#304050"/></Style>
    <Style Selector="TabItem"><Setter Property="Foreground" Value="#AAB6C8"/><Setter Property="Padding" Value="24,13"/></Style>
    <Style Selector="TabItem:selected"><Setter Property="Foreground" Value="#00F3FF"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style Selector="Border.card"><Setter Property="Background" Value="#0B0E16"/><Setter Property="BorderBrush" Value="#304050"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="8"/></Style>
    <Style Selector="TextBlock.title"><Setter Property="Foreground" Value="#00F3FF"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="17"/></Style>
    <Style Selector="TextBlock.body"><Setter Property="Foreground" Value="#B7C3D6"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="21"/><Setter Property="Margin" Value="0,6,0,0"/></Style>
  </Window.Styles>
  <Grid RowDefinitions="64,*,38">
    <Border Grid.Row="0" Background="#090C13" BorderBrush="#3300F3FF" BorderThickness="0,0,0,1" Padding="22,0">
      <Grid ColumnDefinitions="Auto,*,Auto"><Image Width="38" Height="38" Source="avares://AiScanner/Assets/AiScannerIcon.png" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center"><TextBlock FontSize="22" FontWeight="Bold" Foreground="#00F3FF" Text="AI SCANNER"/><TextBlock Foreground="#718097" Text="CROSS-PLATFORM PROCESS INTELLIGENCE"/></StackPanel><TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="#39FF14" Text="●  {Binding Status}"/></Grid>
    </Border>
    <TabControl Grid.Row="1" Margin="18,8">
      <TabItem Header="Tarama">
        <Grid RowDefinitions="Auto,*,Auto" Margin="0,12,0,0">
          <Grid ColumnDefinitions="Auto,Auto,*,Auto"><Button Content="{Binding ScanButtonText}" Click="ScanNow_Click"/><Button Grid.Column="1" Margin="10,0" Content="Dosya konumunu aç" Click="OpenProcessLocation_Click"/><TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="#8997AB" Text="{Binding SummaryText}"/><Button Grid.Column="3" Content="Analiz için prompt oluştur" IsVisible="{Binding HasCompletedAnalysis}" Click="CreatePrompt_Click"/></Grid>
          <ListBox Grid.Row="1" Margin="0,14" ItemsSource="{Binding Assessments}" SelectedItem="{Binding SelectedAssessment}">
            <ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="60,180,90,90,90,100,*" Margin="8,6"><TextBlock Text="{Binding Process.ProcessId}"/><TextBlock Grid.Column="1" Text="{Binding Process.Name}" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="{Binding Process.CpuPercent, StringFormat={}{0:F1}%}"/><TextBlock Grid.Column="3" Text="{Binding Process.WorkingSetBytes, StringFormat={}{0:N0} B}"/><TextBlock Grid.Column="4" Text="{Binding Process.ActiveConnections, StringFormat={}Ağ: {0}}"/><TextBlock Grid.Column="5" Text="{Binding Level}" Foreground="#FFB13B"/><TextBlock Grid.Column="6" Text="{Binding PrimaryReason}" TextTrimming="CharacterEllipsis"/></Grid></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <Border Grid.Row="2" Classes="card"><TextBlock Text="{Binding SelectedDetails}" TextWrapping="Wrap"/></Border>
        </Grid>
      </TabItem>
      <TabItem Header="Süreli Analiz">
        <Grid RowDefinitions="Auto,Auto,*" Margin="0,12,0,0"><StackPanel Orientation="Horizontal" Spacing="9"><Button Tag="1" Content="1 dk" Click="Duration_Click"/><Button Tag="5" Content="5 dk" Click="Duration_Click"/><Button Tag="10" Content="10 dk" Click="Duration_Click"/><Button Tag="20" Content="20 dk" Click="Duration_Click"/><TextBox x:Name="CustomMinutes" Width="100" PlaceholderText="Özel dk"/><Button Content="Başlat" Click="CustomDuration_Click"/><Button Content="Veri klasörünü aç" Click="OpenDataFolder_Click"/></StackPanel><TextBlock Grid.Row="1" Margin="0,12" Foreground="#91A0BA" Text="{Binding PromptStatus}"/><TextBox Grid.Row="2" Text="{Binding LocalAnalysisReport}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" Padding="14"/></Grid>
      </TabItem>
      <TabItem Header="Bilgi">
        <ScrollViewer><StackPanel MaxWidth="1000" HorizontalAlignment="Center" Margin="20"><Image Width="82" Height="82" Source="avares://AiScanner/Assets/AiScannerIcon.png"/><TextBlock HorizontalAlignment="Center" Margin="0,12" FontSize="30" FontWeight="Bold" Foreground="#00F3FF" Text="AI SCANNER TEKNİK REHBERİ"/><TextBlock TextAlignment="Center" Classes="body" Text="Süreç adıyla hüküm vermeyen; CPU, RAM, dosya kimliği, imza, bağlantı ve zaman içindeki davranışı birleştiren yerel telemetri sistemi. Veriler cihazda kalır; AI yalnızca uygulamanın süzüp hazırladığı paketi yorumlar."/>
          <WrapPanel Margin="0,16"><Border Classes="card" Width="470"><StackPanel><TextBlock Classes="title" Text="01 • VERİ TOPLAMA"/><TextBlock Classes="body" Text="PID, ad, başlangıç, çalıştırılabilir yol, SHA-256, oluşturulma zamanı, CPU ve RAM her örnekte kaydedilir. Windows imzayı Authenticode ile, macOS codesign ile doğrular. Linux’ta standart imza zinciri olmadığı için sonuç ‘ölçülemedi’ olur; imzasız diye puanlanmaz."/></StackPanel></Border><Border Classes="card" Width="470"><StackPanel><TextBlock Classes="title" Text="02 • AĞ GÖZLEMİ"/><TextBlock Classes="body" Text="Windows ETW ile süreç başına upload/download baytını ve IP Helper ile bağlantıları ölçer. Linux /proc soket inode’larını PID’lerle eşler. macOS lsof ile etkin TCP uçlarını çözer. Ayrıcalıklı bayt telemetrisi yoksa sıfır trafik varsayılmaz."/></StackPanel></Border><Border Classes="card" Width="470"><StackPanel><TextBlock Classes="title" Text="03 • SÜRELİ DİNLEME"/><TextBlock Classes="body" Text="1, 5, 10, 20 veya özel süre başlatıldığı anda yeni oturum açılır. Yaklaşık dört saniyede bir örnek alınır, geri sayım Tarama düğmesinde görünür ve yalnızca gerçek başlangıç-bitiş aralığı raporlanır."/></StackPanel></Border><Border Classes="card" Width="470"><StackPanel><TextBlock Classes="title" Text="04 • DAVRANIŞ MOTORU"/><TextBlock Classes="body" Text="Sürekli/yükselen CPU, yeni veya yazılabilir konumdaki dosya, imza-ağ birleşimi, gizli yoğun yük, sıra dışı upload/download, yeniden doğan PID ve Windows Görev Yöneticisi açılışından sonra ani düşüş gibi bağımsız sinyaller puanlanır."/></StackPanel></Border><Border Classes="card" Width="470"><StackPanel><TextBlock Classes="title" Text="05 • AKILLI FİLTRE"/><TextBlock Classes="body" Text="Düşük ve değişmeyen yük üreten normal süreçler AI paketinden çıkarılır. CPU sıçraması, ağ, yeni dosya, imza veya PID değişimi taşıyan düşük CPU’lu adaylar korunur; böylece casus yazılım sinyalleri sırf CPU az diye kaybolmaz."/></StackPanel></Border><Border Classes="card" Width="470"><StackPanel><TextBlock Classes="title" Text="06 • RAPOR VE GÜVENLİK"/><TextBlock Classes="body" Text="Yerel JSONL günlük, korelasyonlu analiz paketi, okunabilir rapor ve panoya hazır AI promptu üretir. Dosya silmez, süreç sonlandırmaz ve veri göndermez. Bu araç antivirüs hükmü değil, açıklanabilir inceleme önceliğidir."/></StackPanel></Border></WrapPanel>
        </StackPanel></ScrollViewer>
      </TabItem>
    </TabControl>
    <Border Grid.Row="2" Background="#090C13" BorderBrush="#3300F3FF" BorderThickness="0,1,0,0" Padding="18,0"><Grid><TextBlock VerticalAlignment="Center" Foreground="#738198" Text="v0.3.0 • Windows · Linux · macOS"/><TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"><Run Foreground="#39FF14" Text="Teknesyum"/><Run Foreground="#738198" Text="  •  github.com/Teknesyum/AiScanner  •  Sponsor"/></TextBlock></Grid></Border>
  </Grid>
</Window>
