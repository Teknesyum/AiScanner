<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="AiScanner.App.MainWindow"
        Title="AI Scanner" Width="1280" Height="860" MinWidth="1000" MinHeight="680" Background="#050509" Foreground="#E6FAFF" WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="Button"><Setter Property="Background" Value="#111522"/><Setter Property="Foreground" Value="#00F3FF"/><Setter Property="BorderBrush" Value="#00F3FF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,9"/><Setter Property="CornerRadius" Value="5"/></Style>
    <Style Selector="Button:pointerover"><Setter Property="Background" Value="#15303B"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="TextBox"><Setter Property="Background" Value="#0B0E16"/><Setter Property="Foreground" Value="#E6FAFF"/><Setter Property="BorderBrush" Value="#304050"/></Style>
    <Style Selector="TabItem"><Setter Property="Foreground" Value="#AAB6C8"/><Setter Property="Padding" Value="22,13"/></Style>
    <Style Selector="TabItem:selected"><Setter Property="Foreground" Value="#00F3FF"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style Selector="Border.card"><Setter Property="Background" Value="#0B0E16"/><Setter Property="BorderBrush" Value="#304050"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
    <Style Selector="TextBlock.title"><Setter Property="Foreground" Value="#00F3FF"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="19"/></Style>
    <Style Selector="TextBlock.body"><Setter Property="Foreground" Value="#C5D0E0"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="16"/><Setter Property="LineHeight" Value="25"/><Setter Property="Margin" Value="0,8,0,0"/></Style>
    <Style Selector="TextBlock.step"><Setter Property="Foreground" Value="#E8F8FF"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="17"/><Setter Property="LineHeight" Value="27"/></Style>
  </Window.Styles>
  <Grid RowDefinitions="64,Auto,*,38">
    <Border Grid.Row="0" Background="#090C13" BorderBrush="#3300F3FF" BorderThickness="0,0,0,1" Padding="22,0">
      <Grid ColumnDefinitions="Auto,*,Auto"><Image Width="38" Height="38" Source="avares://AiScanner/Assets/AiScannerIcon.png" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center"><TextBlock FontSize="22" FontWeight="Bold" Foreground="#00F3FF" Text="AI SCANNER"/><TextBlock Foreground="#718097" Text="CROSS-PLATFORM PROCESS INTELLIGENCE"/></StackPanel><TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="#39FF14" Text="●  {Binding Status}"/></Grid>
    </Border>
    <Border Grid.Row="1" IsVisible="{Binding IsPromptNotificationVisible}" Background="#122D1B" BorderBrush="#39FF14" BorderThickness="1" CornerRadius="6" Margin="18,8,18,0" Padding="14,10"><TextBlock HorizontalAlignment="Center" FontSize="15" FontWeight="Bold" Foreground="#7CFF68" Text="✓ Analiz promptu panoya kopyalandı"/></Border>
    <TabControl Grid.Row="2" Margin="18,8">
      <TabItem Header="Tarama">
        <Grid RowDefinitions="Auto,*,Auto" Margin="0,12,0,0">
          <Grid ColumnDefinitions="Auto,Auto,*,Auto"><Button Content="{Binding ScanButtonText}" Click="ScanNow_Click"/><Button Grid.Column="1" Margin="10,0" Content="Dosya konumunu aç" Click="OpenProcessLocation_Click"/><TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="#8997AB" Text="{Binding SummaryText}"/><Button Grid.Column="3" Content="{Binding PromptButtonText}" Background="{Binding PromptButtonBackground}" Foreground="{Binding PromptButtonForeground}" BorderBrush="{Binding PromptButtonBorder}" IsVisible="{Binding HasCompletedAnalysis}" Click="CreatePrompt_Click"/></Grid>
          <ListBox Grid.Row="1" Margin="0,14" ItemsSource="{Binding Assessments}" SelectedItem="{Binding SelectedAssessment}"><ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="60,180,90,90,90,100,*" Margin="8,6"><TextBlock Text="{Binding Process.ProcessId}"/><TextBlock Grid.Column="1" Text="{Binding Process.Name}" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="{Binding Process.CpuPercent, StringFormat={}{0:F1}%}"/><TextBlock Grid.Column="3" Text="{Binding Process.WorkingSetBytes, StringFormat={}{0:N0} B}"/><TextBlock Grid.Column="4" Text="{Binding Process.ActiveConnections, StringFormat={}Ağ: {0}}"/><TextBlock Grid.Column="5" Text="{Binding Level}" Foreground="#FFB13B"/><TextBlock Grid.Column="6" Text="{Binding PrimaryReason}" TextTrimming="CharacterEllipsis"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
          <Border Grid.Row="2" Classes="card"><TextBlock Text="{Binding SelectedDetails}" TextWrapping="Wrap"/></Border>
        </Grid>
      </TabItem>
      <TabItem Header="Süreli Analiz">
        <Grid RowDefinitions="Auto,Auto,*" Margin="0,12,0,0"><Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="9"><Button Tag="1" Content="1 dk" Click="Duration_Click"/><Button Tag="5" Content="5 dk" Click="Duration_Click"/><Button Tag="10" Content="10 dk" Click="Duration_Click"/><Button Tag="20" Content="20 dk" Click="Duration_Click"/><TextBox x:Name="CustomMinutes" Width="100" PlaceholderText="Özel dk"/><Button Content="Başlat" Click="CustomDuration_Click"/><Button Content="Veri klasörünü aç" Click="OpenDataFolder_Click"/></StackPanel><Button Grid.Column="1" Margin="10,0,0,0" Content="{Binding PromptButtonText}" Background="{Binding PromptButtonBackground}" Foreground="{Binding PromptButtonForeground}" BorderBrush="{Binding PromptButtonBorder}" IsVisible="{Binding HasCompletedAnalysis}" Click="CreatePrompt_Click"/></Grid><TextBlock Grid.Row="1" Margin="0,12" Foreground="#91A0BA" Text="{Binding PromptStatus}"/><TextBox Grid.Row="2" Text="{Binding LocalAnalysisReport}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" Padding="14"/></Grid>
      </TabItem>
      <TabItem Header="Nasıl Kullanılır?">
        <ScrollViewer><StackPanel MaxWidth="1050" HorizontalAlignment="Center" Margin="24">
          <TextBlock HorizontalAlignment="Center" FontSize="30" FontWeight="Bold" Foreground="#39FF14" Text="5 ADIMDA AI SCANNER"/>
          <TextBlock Margin="0,8,0,24" HorizontalAlignment="Center" Foreground="#AAB8CA" FontSize="16" Text="Tarama ve AI raporu için kısa kullanım rehberi"/>
          <Border Classes="card" BorderBrush="#00F3FF"><TextBlock Classes="step"><Run Foreground="#00F3FF" FontWeight="Bold" Text="1 • ŞİMDİ TARA  "/><Run Text="Tarama sekmesindeki düğmeye basın. Çalışan süreçler yerel olarak incelenir. Bir süreci seçerek yolunu, SHA-256 değerini ve yayıncısını görün."/></TextBlock></Border>
          <Border Classes="card" BorderBrush="#C779FF"><TextBlock Classes="step"><Run Foreground="#C779FF" FontWeight="Bold" Text="2 • SÜRELİ DİNLE  "/><Run Text="Süreli Analiz sekmesinden 1, 5, 10, 20 veya özel dakika seçin. Program süre dolana kadar veri toplar. Miner ve aralıklı casus yazılım davranışları için 10–20 dakika önerilir."/></TextBlock></Border>
          <Border Classes="card" BorderBrush="#FFB000"><TextBlock Classes="step"><Run Foreground="#FFCA55" FontWeight="Bold" Text="3 • YEREL RAPORU OKU  "/><Run Text="Süre bitince önemsiz ve kararlı süreçler elenir. Yüksek puan kesin zararlı demek değildir; önce incelenmesi gereken adayı gösterir."/></TextBlock></Border>
          <Border Classes="card" BorderBrush="#39FF14"><TextBlock Classes="step"><Run Foreground="#7CFF68" FontWeight="Bold" Text="4 • PROMPTU KOPYALA  "/><Run Text="Analiz için prompt oluştur düğmesine basın. Düğme yeşile döner ve kopyalandığını bildirir. Promptu Codex veya başka bir AI’a yapıştırın."/></TextBlock></Border>
          <Border Classes="card" BorderBrush="#FF647C"><TextBlock Classes="step"><Run Foreground="#FF8295" FontWeight="Bold" Text="5 • GÜVENLİ DOĞRULA  "/><Run Text="AI dosya isterse promptta yolu yazan analysis-*.json dosyasını yükleyin. Yol, yayıncı ve SHA-256 değerini doğrulamadan dosya silmeyin veya süreç sonlandırmayın."/></TextBlock></Border>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="Bilgi">
        <ScrollViewer><StackPanel MaxWidth="1180" HorizontalAlignment="Stretch" Margin="28"><Image Width="82" Height="82" Source="avares://AiScanner/Assets/AiScannerIcon.png"/><TextBlock HorizontalAlignment="Center" Margin="0,12,0,6" FontSize="30" FontWeight="Bold" Foreground="#00F3FF" Text="AI SCANNER TEKNİK REHBERİ"/><TextBlock MaxWidth="1000" HorizontalAlignment="Center" TextAlignment="Center" Classes="body" Margin="0,0,0,24" Text="CPU, RAM, dosya kimliği, imza, bağlantı ve zaman içindeki davranışı birlikte inceleyen yerel telemetri ve önceliklendirme sistemi."/>
          <Border Classes="card"><StackPanel><TextBlock Classes="title" Text="01 • VERİ TOPLAMA"/><TextBlock Classes="body" Text="PID, süreç adı, başlangıç zamanı, çalıştırılabilir dosya yolu, SHA-256, dosya oluşturma zamanı, CPU ve RAM her örnekte kaydedilir. Windows Authenticode, macOS codesign doğrulaması kullanır. Linux’ta standart imza zinciri yoksa sonuç ölçülemedi olarak tutulur; imzasız diye yanlış puanlanmaz."/></StackPanel></Border>
          <Border Classes="card"><StackPanel><TextBlock Classes="title" Text="02 • AĞ GÖZLEMİ"/><TextBlock Classes="body" Text="Windows ETW ile süreç başına gönderilen/alınan baytları ve IP Helper ile bağlantıları ölçer. Linux /proc soketlerini PID’lerle eşler. macOS lsof ile etkin TCP uçlarını çözer. Bayt telemetrisi yoksa sıfır trafik varsayılmaz."/></StackPanel></Border>
          <Border Classes="card"><StackPanel><TextBlock Classes="title" Text="03 • SÜRELİ DİNLEME"/><TextBlock Classes="body" Text="Seçtiğiniz anda yeni bir oturum başlar. Yaklaşık dört saniyede bir örnek alınır, geri sayım görünür ve yalnızca gerçek başlangıç-bitiş aralığı rapora dahil edilir."/></StackPanel></Border>
          <Border Classes="card"><StackPanel><TextBlock Classes="title" Text="04 • DAVRANIŞ MOTORU"/><TextBlock Classes="body" Text="Sürekli veya yükselen CPU, yazılabilir konumdaki yeni dosyalar, imza-ağ birleşimi, gizli yoğun yük, sıra dışı trafik, yeniden doğan PID ve Windows Görev Yöneticisi açılınca ani yük düşüşü gibi bağımsız sinyaller puanlanır."/></StackPanel></Border>
          <Border Classes="card"><StackPanel><TextBlock Classes="title" Text="05 • AKILLI FİLTRE"/><TextBlock Classes="body" Text="Düşük ve değişmeyen yük üreten normal süreçler AI paketinden çıkarılır. CPU sıçraması, ağ, yeni dosya, imza veya PID değişimi taşıyan düşük CPU’lu adaylar korunur; AI gereksiz veriyle boğulmaz."/></StackPanel></Border>
          <Border Classes="card"><StackPanel><TextBlock Classes="title" Text="06 • RAPOR VE GÜVENLİK"/><TextBlock Classes="body" Text="Yerel JSONL günlük, korelasyonlu analiz paketi, okunabilir rapor ve panoya hazır prompt üretir. Dosya silmez, süreç sonlandırmaz ve veriyi kendiliğinden internete göndermez. Bu araç antivirüs hükmü değil, açıklanabilir inceleme önceliğidir."/></StackPanel></Border>
        </StackPanel></ScrollViewer>
      </TabItem>
    </TabControl>
    <Border Grid.Row="3" Background="#090C13" BorderBrush="#3300F3FF" BorderThickness="0,1,0,0" Padding="18,0"><Grid><TextBlock VerticalAlignment="Center" Foreground="#738198" Text="{Binding VersionText}"/><TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"><Run Foreground="#39FF14" Text="Teknesyum"/><Run Foreground="#738198" Text="  •  github.com/Teknesyum/AiScanner  •  Sponsor"/></TextBlock></Grid></Border>
  </Grid>
</Window>
